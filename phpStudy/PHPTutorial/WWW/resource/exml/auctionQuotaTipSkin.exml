<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="SkinAuctionQuotaTip" xmlns:e="http://ns.egret.com/eui" xmlns:ns1="*"
        xmlns:w="http://ns.egret.com/wing" width="580" height="930">
	<w:Config id="15a98a3982e" />
	<e:Rect id="bgClose" left="0" right="0" top="0" bottom="0" fillAlpha="0.7" 
	         />
	<e:Group width="450" height="516" horizontalCenter="0" verticalCenter="0">
		<e:Image source="bantoutiaobg" height="30" horizontalCenter="0" bottom="-30" scale9Grid="128,2,15,41" width="300"/>
		<e:Label horizontalCenter="0" text="Chạm vùng trống để đóng cửa sổ" size="20" x="30" bold="true" bottom="-24" textColor="0x7E6437"/>
		<e:Image source="tongyongkuang3bg" scale9Grid="23,24,3,2"   
		           left="0" right="0" top="0" bottom="0"/>
		<e:Image source="tongyonglabbg" y="40" height="368" scale9Grid="40,20,30,30"
		          left="6" right="6" visible="false"/>
		<e:Image width="412" height="187" y="151" source="bantoutiaobg" scale9Grid="124,18,9,6" horizontalCenter="3"/>
		<e:Image source="tongyongkuang3tou" scale9Grid="71,5,267,37"   left="0" right="0"/>
		<e:Label text="Hạn mức chi tiêu ở hệ thống đấu giá không đủ, không thể đấu giá" size="20" id="tipText0" textAlign="center" y="85" horizontalCenter="1" textColor="0xD1C28F"/>
		<e:Image source="teshuwenzibg" y="151" horizontalCenter="0.5" width="239"/>

		<e:Label text="Có thể nhận hạn mức qua các cách sau" size="18" id="tipText1" textAlign="center" y="162" horizontalCenter="0.5" textColor="0xD1C28F"/>
		<e:Image y="201" source="gantanhao" left="37"/>
		<e:Label text="Mỗi lần nạp 1 Nguyên Bảo, nhận 1 Nguyên Bảo hạn mức mua" size="18" id="tipText2" textAlign="left" y="204" textColor="0xD1C28F" verticalAlign="justify" left="65"/>
		<e:Image source="gantanhao" y="227" left="37"/>
		<e:Label text="Mỗi 1 điểm Hoạt Náo, có thể chuyển thành 10 Nguyên Bảo hạn mức mua" size="18" id="tipText3" textAlign="left" y="230" textColor="0xD1C28F" verticalAlign="justify" left="64"/>
		<e:Image source="gantanhao" y="254" left="37"/>
		<e:Label text="Hạn mức Hoạt Náo tích lũy tối đa 50000, dùng hết có thể tích lũy tiếp" size="18" id="tipText4" textAlign="left" y="256" textColor="0xD1C28F" verticalAlign="justify" left="62"/>
		<e:Label id="text" text="（Khi đấu giá ưu tiên dùng hạn mức Hoạt Náo）" size="20" horizontalCenter="0" bottom="187" x="20" y="20" textColor="0x9F946D"/>
		<e:Label text="Nhắc nhở đấu giá" size="24" y="10" textColor="0xbd600d" bold="true"  horizontalCenter="0"/>
		<e:Label id="rechargeQuota" text="Hạn mức nạp còn lại：" size="20" horizontalCenter="-21" bottom="93" textColor="0x20CB30"/>
		<e:Label id="positiveQuota" text="Hạn mức Hoạt Náo còn lại：" size="20" horizontalCenter="-21" bottom="123" textColor="0x20CB30"/>
		<e:Label id="rechargeQuotaNum" text="10000" size="20" textColor="0x20CB30" horizontalCenter="72" bottom="93" textAlign="left"/>
		<e:Label id="positiveQuotaNum" text="50000" size="20" textColor="0x20CB30" horizontalCenter="73" bottom="123" x="10" y="10"/>


		<e:Button id="goRechargeBtn" label="Đi nạp" skinName="SkinBtn1" width="160" horizontalCenter="0" bottom="19"/>
</e:Group>
</e:Skin>