			<e:Image source="leibeifengexian" horizontalCenter="-155" verticalCenter="-1"/>
			<e:Image source="leibeifengexian" horizontalCenter="-14" verticalCenter="-1"/>
			<e:Label id="infoDesc0" height="28" text="一个字，干！" size="18" textAlign="left" verticalAlign="justify" horizontalCenter="5" width="324" anchorOffsetY="0" x="92" scaleX="1" scaleY="1" verticalCenter="10.5" fontFamily="Microsoft YaHei" textColor="0xFFFFFF" visible="false"/>
