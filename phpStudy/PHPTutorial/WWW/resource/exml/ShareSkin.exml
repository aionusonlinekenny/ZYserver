<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="SkinShare" width="600" height="948" xmlns:e="http://ns.egret.com/eui" xmlns:ns1="*" xmlns:w="http://ns.egret.com/wing">
	<e:Group top="0" bottom="0" left="0" right="0">
