		<e:Label text="Tụ Linh Đoạt Trận" horizontalCenter="0" top="-6" size="22" textColor="0x084151" fontFamily="Microsoft YaHei"/>
		<e:Group x="44" y="51" scaleX="1" scaleY="1">
			<e:Label text="Mô tả sự kiện：" size="20" scaleX="1" scaleY="1" horizontalCenter="0" y="0" fontFamily="Microsoft YaHei" textColor="0xffff00"/>
		</e:Group>
		<e:Label id="desc" text="       Bỉ Kỳ về đêm quyến rũ và đầy bí ẩn. Hãy vào khám phá lúc đêm tối gió lộng, chắc chắn bạn sẽ vô cùng phấn khích." y="86" size="20" width="380" scaleX="1" scaleY="1" lineSpacing="10" textAlign="left" textColor="0x001828" fontFamily="Microsoft YaHei" x="44"/>
		<e:Group x="44" y="181" scaleX="1" scaleY="1">
			<e:Label text="Luật chơi sự kiện：" size="20" scaleX="1" scaleY="1" x="0" y="0" fontFamily="Microsoft YaHei" textColor="0xffff00"/>
		</e:Group>
		<e:Label id="rule" text="1.Thời gian sự kiện：|C:0x00ff00&amp;T:Thứ 2, 4, 6 hàng tuần 20:30-20:45|\n2.Tham gia sự kiện là nhận được|C:0x00ff00&amp;T:Công Huân|phần thưởng\n3.Sau khi vào sự kiện người chơi sẽ được chia ngẫu nhiên thành|C:0x00ff00&amp;T:2 phe đối lập|，mỗi|C：0x00ff00&amp;T:5 phút|sẽ phân lại phe\n4.Đánh bại người chơi, hỗ trợ, giết quái, tham gia liên tục đều nhận được điểm, điểm cá nhân càng cao thì thưởng càng nhiều\n5.Sau khi sự kiện kết thúc sẽ phát thưởng xếp hạng theo biểu hiện tổng hợp của người chơi\n|C:0x5186fd&amp;T:PS：Càng ở lâu trong Huyết Chiến Bỉ Kỳ Thành thì càng nhận nhiều Công Huân|" size="18" width="380" scaleX="1" scaleY="1" lineSpacing="10" fontFamily="Microsoft YaHei" textColor="0x001828" x="44" top="209" bottom="109"/>
		<e:Group anchorOffsetX="0" anchorOffsetY="0" top="50" horizontalCenter="0" bottom="85" height="317" y="209" visible="false">





			<e:layout>
				<e:VerticalLayout horizontalAlign="left"/>
			</e:layout>
