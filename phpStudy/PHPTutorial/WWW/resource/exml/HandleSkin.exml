<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="SkinHandle" width="600" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing" xmlns:euiextension="euiextension.*"
	xmlns:ns1="*"  height="948" states="plunder,revenge,done" >
	<w:Config id="1586b349dbe"/>
	<e:Rect id="bgClose" left="0" right="0" top="0" bottom="0" fillAlpha="0.5" fillAlpha.done="0.7"/>
	<e:Group id="anigroup" horizontalCenter="0" verticalCenter="0" height="530" width="524" height.done="580">
		<e:Group name="装备" width="524" height="485"  verticalCenter="0" horizontalCenter="0" x="-114" y="110" height.done="540">
			<e:Image right="0" top="28" bottom="0" left="0" source="tongyong_dikuang2" scale9Grid="32,6,56,62" anchorOffsetY="0"/>
			<e:Image right="0" left="0" source="tongyong_juanzhou" scale9Grid="204,5,63,18" y="16"/>
			<e:Image y="0" source="tongyong_titlebg" horizontalCenter="0" scale9Grid="102,0,47,41" width="292"/>
			<e:Image width="464" height="400" y="50" source="tongyong_dikuang1" scale9Grid="10,10,64,66" horizontalCenter="0" anchorOffsetY.done="0" horizontalCenter.done="0" height.done="339"/>
			<e:Label id="Title" text="天魔矿工" size="22" text.plunder="天魔矿工(可掠夺)" x.plunder="-48" y.plunder="0" top="13" text.revenge="复 仇" text.done="开采完毕" horizontalCenter.done="0" horizontalCenter="0" fontFamily="Microsoft YaHei" textColor="0x39566a"/>
			<e:Group includeIn="revenge,done" y="45" horizontalCenter="0" y.done="63" height.done="154" y.revenge="63" height.revenge="100" width="446">

				<e:Image top="0" bottom="0" left="0" right="0" scale9Grid="7,6,12,13" includeIn="revenge,done" source="tongyonglabbg" scale9Grid.revenge="47,10,22,50" bottom.done="0"/>

				<e:Group includeIn="done" verticalCenter="2" x="1">
					<e:Group   x="6" y="-6">
					<e:Image    width="159"  height="153" horizontalCenter="0" source="kuanggongiconbg_png"  y="8"/>
					<e:Image id="worker"  width="77"  height="78" y="50" horizontalCenter="-4" source="kuanggong0_png" />
					</e:Group>

					<e:Label id="nameTxt" text="裸体矿工" y="124" size="18"   x="50" fontFamily="Microsoft YaHei" textColor="0xffff00" stroke="0.8"/>
				</e:Group>

			<e:Label text="战斗力：" x="123" size="20" textColor="0x9F946D" bottom="20" includeIn="plunder,revenge" text.revenge="战斗力:" fontFamily.revenge="Microsoft YaHei" textColor.revenge="0x001828" fontFamily="Microsoft YaHei"/>
			<e:Label id="enemyPower" x="203" size="20" textColor="0xFF9900" bottom="20" includeIn="plunder,revenge" fontFamily.revenge="Microsoft YaHei" textColor.revenge="0x0038ab" x.revenge="196" fontFamily="Microsoft YaHei"/>
			<e:Label text="掠夺者：" x="123" size="20" textColor="0x9F946D" top="20" includeIn="plunder,revenge" fontFamily.revenge="Microsoft YaHei" text.revenge="掠夺者:" textColor.revenge="0x001828" fontFamily="Microsoft YaHei"/>
			<e:Label id="enemy"  x="203" size="20" textColor="0xFF9900" top="20" includeIn="plunder,revenge" fontFamily.revenge="Microsoft YaHei" textColor.revenge="0x0038ab" x.revenge="196" fontFamily="Microsoft YaHei"/>
			<e:Group x="20" includeIn="revenge"   verticalCenter="0">
				<e:Image y="0" x="0" width="80" height="80" source="touxiangkuang0" scale9Grid="6,6,1,1" includeIn="revenge,done"/>
				<e:Image id="myFace0" x="5" y="5" width="70" height="70" includeIn="revenge,done" source="yuanhead10"/>
			</e:Group>
			<e:Label id="reward" text="" includeIn="done" size="20"   width="182" horizontalCenter="32" top="40" fontFamily="Microsoft YaHei" textColor="0x001828"/>
			<e:Label id="minus" text="" includeIn="done" size="20"   textColor="0xff0000" width="100" horizontalCenter="188" top="40" fontFamily="Microsoft YaHei"/>
				<e:Label id="nameTxt1" text="裸体矿工" size="20"   includeIn="done" y="124" x="50" fontFamily="Microsoft YaHei" textColor="0xffff00" stroke="0.8" visible="false"/>

			<e:Group x="150" y="19" includeIn="plunder,revenge">
				<e:layout>
				<e:VerticalLayout horizontalAlign="left" verticalAlign="middle" gap="5"/>
				</e:layout>
			</e:Group>
			<e:Group x="290" y="19" includeIn="plunder,revenge">
				<e:Label text="-100" includeIn="done" x="8" y="-21" textColor="0xFF0000" size="20" id="minus1"  />
				<e:Label text="-150" includeIn="done" x="8" y="-21" textColor="0xFF0000" size="20" id="minus2"  />
				<e:layout>
				<e:VerticalLayout horizontalAlign="left" verticalAlign="middle" gap="5"/>
				</e:layout>
			</e:Group>
			</e:Group>
			<e:Group includeIn="revenge,done" y="155" horizontalCenter="0" width="446" height.revenge="145" height.plunder="145" anchorOffsetY.done="0" horizontalCenter.done="0" height.done="154" y.done="222" horizontalCenter.revenge="0" y.revenge="170">
				<e:Image top="0" bottom="0" source="tongyonglabbg" left="0" right="0" includeIn="revenge,done" scale9Grid="50,48,21,21"/>

				<e:Image includeIn="done" y="6" scale9Grid="16,0,2,24" height="26" width="101" source="wkldck_png" x="10"/>
			<e:Label text="掠夺时间:" x="23" size="20" top="10" includeIn="revenge" fontFamily="Microsoft YaHei" textColor="0x001828"/>
			<e:Label text="掠夺资源:" x="23" size="20" top="40" includeIn="revenge" textColor="0x001828" fontFamily="Microsoft YaHei"/>
			<e:Group x="123" y="10" includeIn="revenge">
				<e:Label id="time" text="" x="54" y="59" size="20"   includeIn="revenge" fontFamily="Microsoft YaHei" textColor="0x0038ab"/>
				<e:layout>
				<e:HorizontalLayout gap="15"/>
				</e:layout>
			</e:Group>
			<e:List id="robaward" x="123" itemRendererSkinName="SkinItem" width="304" height="100" top="40" includeIn="revenge" anchorOffsetX="0">
				<e:layout>
				<e:HorizontalLayout gap="30" horizontalAlign="center" verticalAlign="middle"/>
				</e:layout>
			</e:List>
			<e:Label text="掠夺情况：" includeIn="done" x="13" size="20" y="7.33" fontFamily="Microsoft YaHei" textColor="0x001828" visible="false"/>
			<e:Scroller width="420" height="113" includeIn="done" x="20"  y="32" anchorOffsetY="0">
				<e:Group>
				<e:List id="recordList" includeIn="done"   itemRendererSkinName="SkinDoneRecordItem"   right="0" bottom="0" left="0" top="0">
					<e:layout>
					<e:VerticalLayout gap="0" horizontalAlign="left" verticalAlign="middle"/>
					</e:layout>
				</e:List>
				</e:Group>
			</e:Scroller>
				<e:Label id="noRob" text="恭喜你，你的矿工没有被掠夺！" includeIn="done" size="20" horizontalCenter="0" verticalCenter="0" fontFamily="Microsoft YaHei" textColor="0x00842c" visible="false"/>
			</e:Group>
			<e:Group y="70"  y.plunder="63" includeIn="plunder" width="446" horizontalCenter="0.5" height="122">
				<e:Image top="0" bottom="0" includeIn="plunder" source="tongyonglabbg" scale9Grid="47,6,24,53" width="446" horizontalCenter="0"/>
				<e:List id="awardList" x="116"     includeIn="plunder,done" itemRendererSkinName="SkinItem2" y="17">
					<e:layout>
					<e:HorizontalLayout horizontalAlign="center" verticalAlign="middle" gap="30"/>
					</e:layout>
				</e:List>
				<e:Image includeIn="plunder" scale9Grid="12,0,3,24" width="91" height="26" source="wkldjl_png" x="8" y="8"/>




			</e:Group>
			<e:Group y="188"  height="122"  width="446" horizontalCenter="0" includeIn="plunder" horizontalCenter.plunder="0.5" y.plunder="189">
				<e:Image top="0" bottom="0" left="0" right="0" includeIn="plunder" source="tongyonglabbg" scale9Grid="49,7,20,62"/>
			<e:Label text="玉矿主人:" x="13" y="30" size="20" fontFamily="Microsoft YaHei" textColor="0x001828"/>
			<e:Label text="战斗力:" x="253" y="30" size="20" fontFamily="Microsoft YaHei" textColor="0x001828"/>
			<e:Label text="主人仙盟:" x="13" y="72" size="20" fontFamily="Microsoft YaHei" textColor="0x001828"/>
			<e:Label id="owner" text="" x="106" y="30" size="20" fontFamily="Microsoft YaHei" textColor="0x0038ab"/>
			<e:Label id="power" text="" x="313" y="30" size="20" x.plunder="322" fontFamily="Microsoft YaHei" textColor="0x0038ab"/>
			<e:Label id="gang" text="" x="106" y="72" size="20" fontFamily="Microsoft YaHei" textColor="0x00842c"/>
			<e:Label id="noGang" text="暂未加入仙盟" x="113" y="55" size="20" textColor="0x9F946D" visible="false"/>
			</e:Group>
			<e:Label id="workNum" text="剩余次数：2/3" y="2" size="20"   text.revenge="复仇成功可双倍取回资源并全服公告" y.revenge="328" text.plunder="剩余次数：2/3" horizontalCenter.done="0" bottom.done="78" includeIn="plunder,revenge" horizontalCenter.revenge="0" horizontalCenter.plunder="0" horizontalCenter="0" fontFamily="Microsoft YaHei" textColor="0xffffff" y.plunder="327"/>
			<e:Group y.done="278" horizontalCenter="0.5" x="95"   horizontalCenter.revenge="1" bottom.revenge="68" bottom.plunder="68" horizontalCenter.plunder="0" includeIn="revenge">
			<e:layout>
				<e:HorizontalLayout gap="0" horizontalAlign="left" verticalAlign="middle"/>
			</e:layout>
			</e:Group>
			<e:Button id="handleBtn" label="掠夺玉矿" label.revenge="复 仇" label.done="领取奖励" skinName="SkinBtn1" horizontalCenter.revenge="0" horizontalCenter.plunder="0" width="176" height="69" y.plunder="365" y="103" y.done="410" x.done="54" y.revenge="370"/>
			<e:Button id="double" label="双倍领取" width="176" height="69" skinName="SkinBtn1" includeIn="done" y="410" x="294"/>
			<e:Group includeIn="done" y="482" x="339">
				<e:Image source="szyuanbao" width="40" y="0"  x="0"/>
				<e:Label id="cost" text="1980" size="20" x="42" y="4"  fontFamily="Microsoft YaHei" textColor="0xffff00"/>
			</e:Group>
			<e:Button id="btnClose" label="Button" x="468" y="2" skinName="SkinBtn0" icon="tongyong_btnclose" visible="false"/>
		</e:Group>
		<e:Group id="tipGroup" touchChildren="false" touchEnabled="false" y="332" x="-129" includeIn="plunder,revenge,done" width="399" visible.done="false">
			<e:Image source="bantoutiaobg" height="36" y="0" horizontalCenter="0" scale9Grid="128,2,15,41" width="300"/>
			<e:Label text="点击空白区域关闭窗口" size="20" y="5" horizontalCenter="0" fontFamily="Microsoft YaHei" textColor="0xffffff"/>
			<e:Button id="closeBtn1" label="按钮" y="-17" skinName="SkinBtn0" right="-10" x="188"   visible="false"/>
		</e:Group>
		<e:layout>
			<e:VerticalLayout gap="10" horizontalAlign="center"/>
		</e:layout>
	</e:Group>
</e:Skin>