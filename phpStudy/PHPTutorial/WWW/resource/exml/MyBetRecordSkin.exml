		<e:Label text="点击空白区域关闭窗口" size="20" horizontalCenter="0" textColor="0xffffff" fontFamily="Microsoft YaHei" verticalCenter="0"/>
		</e:Group>
		<e:Button id="closebtn" label="Button" skinName="SkinBtn0" icon="tongyong_btnclose" horizontalCenter="220" top="-4" x="440" y="-153" scaleX="1" scaleY="1"/>
	</e:Group>
	<e:Image source="wodexiazhu_png" alpha="0.7" visible="false"/>
</e:Skin>