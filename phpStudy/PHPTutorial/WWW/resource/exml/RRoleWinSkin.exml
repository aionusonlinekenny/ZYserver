	<e:Group width="600" height="86" horizontalCenter="0" verticalCenter="315">
		<e:Image id="bg" width="600" height="110" verticalCenter="-3" horizontalCenter="0" anchorOffsetY="0" scale9Grid="6,4,589,54" source="bantoumingkuang3_png"/>
		<e:Label id="nameTxt" text="Tên phải có 6 chữ" size="20" y="16" x="145.26" fontFamily="Microsoft YaHei" textColor="0xffffff" textAlign="left"/>
