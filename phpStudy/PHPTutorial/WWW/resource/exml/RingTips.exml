<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="SkinRingTips" currentState="lock" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing"
        xmlns:euiextension="euiextension.*" xmlns:ns1="*" width="580" height="930" states="lock,active,actived">
	<w:Config id="1586b3502a7" />
	<e:Rect id="bgClose" fillAlpha="0.8" top="0" left="0" right="0" bottom="0" />
	<ns1:RoleSelectPanel id="roleSelect" skinName="SkinRoleSelectPanel" top="0" horizontalCenter="0" visible="false"/>
	<e:Group id="group"  horizontalCenter="0" verticalCenter="-50">
		<e:Group id="mcGroup" y="0" horizontalCenter="0">
			<e:Image id="background" source="tongyongtip1" scale9Grid="7,6,11,12" left="1" right="1"  
			         top="0"  height="590" anchorOffsetY="0"/>
			<e:Image id="background2" source="tongyongtip2" scale9Grid="18,18,43,4" height="591" top="0" left="0" right="0"/>

			<e:Image id="qualityImg" left="1" right="1" top="1"  
			         y.lock="2"  anchorOffsetY="0" height="414" source="quali3_png" scale9Grid="7,9,13,505"/>
			<e:Image width="350" y.lock="13" top="61" bottom="5" horizontalCenter="0" right="5" left="5" source="ringbg2_png" anchorOffsetY="0"/>
			<e:Image source="tongyongtip2" left="0" right="0" scale9Grid="18,18,2,4" top="0" bottom="0"  
			          source.actived="tongyongtip2" visible="false"/>
			<e:Label id="nameLabel" text="Nhẫn Tê Liệt" size="30" textAlign="center" textColor="0xFF0000" top="10" y="20"
			           horizontalCenter.actived="0" horizontalCenter.active="0" textColor.lock="0xff0000"
			         top.lock="14" size.lock="30" horizontalCenter.lock="0" horizontalCenter="0" fontFamily="Microsoft YaHei" stroke="1"/>
			<e:Image y="276" scale9Grid="85,1,6,1" width="340" horizontalCenter.actived="-4" horizontalCenter.active="-4"
			         x="5"   scale9Grid.lock="120,1,16,1" width.lock="325" x.lock="0"  source="bantoutiaobg8" height="45"/>
			<ns1:PowerPanel id="powerPanel" y="267" x="48" skinName="Skin2PowerPanel"/>
			<e:Image id="tips" y="0"  source="tjyijihuo" scaleX="1.2" scaleY="1.2" right="-2" source.lock="tjweijihuo" source.active="tjweijihuo"/>
			<e:Group y="333.67" horizontalCenter="0.5">
				<e:Group y="0"    width="325" horizontalCenter="0" x="0">
					<e:Label y="0" text="【Thuộc tính cộng thêm】" size="20" x="0"   textColor.lock="0x00ffff"
					          fontFamily="Microsoft YaHei" textColor="0x00ffff"/>

					<e:Group x="24" y="25">
						<e:Label id="attr0" text="Công kích：" size="18" fontFamily="Microsoft YaHei" textColor="0x00ffff"/>
						<e:Label id="value0" text="+1000" size="18" fontFamily="Microsoft YaHei" textColor="0xffffff"/>
						<e:layout>
							<e:HorizontalLayout gap="4"/>
						</e:layout>
					</e:Group>
					<e:Group x="190" x.active="198" y="25">
						<e:Label id="attr1" text="Tỷ lệ Bạo kích：" size="18" fontFamily="Microsoft YaHei" textColor="0x00ffff"/>
						<e:Label id="value1" text="+1000" size="18" fontFamily="Microsoft YaHei" textColor="0xffffff"/>
						<e:layout>
							<e:HorizontalLayout gap="4"/>
						</e:layout>
					</e:Group>
					<e:Group x="24" y="50">
						<e:Label id="attr2" text="Kháng phép：" size="18" fontFamily="Microsoft YaHei" textColor="0x00ffff"/>
						<e:Label id="value2" text="+1000" size="18" fontFamily="Microsoft YaHei" textColor="0xffffff"/>
						<e:layout>
							<e:HorizontalLayout gap="4"/>
						</e:layout>
					</e:Group>
					<e:Group x="190" x.active="198" y="50">
						<e:Label id="attr3" text="Sinh lực：" size="18" fontFamily="Microsoft YaHei" textColor="0x00ffff"/>
						<e:Label id="value3" text="+1000" size="18" fontFamily="Microsoft YaHei" textColor="0xffffff"/>
						<e:layout>
							<e:HorizontalLayout gap="4"/>
						</e:layout>
					</e:Group>

				</e:Group>
				<e:Group y="70"    width="325" horizontalCenter="0" x="0">
					<e:Label id="specialAttr" y="25" text="       Khi nhân vật tấn công, có tỷ lệ kích hoạt hiệu ứng Tê Liệt, khiến mục tiêu không thể tấn công, di chuyển, kéo dài 2 giây." size="20" verticalAlign="justify" x="0" textAlign="left"
					           text.lock="Khi nhân vật tấn công, có tỷ lệ kích hoạt hiệu ứng Tê Liệt, khiến mục tiêu không thể tấn công, di chuyển, kéo dài 2 giây." width.lock="324"  width="324" fontFamily="Microsoft YaHei" textColor="0x6b9baa"/>
					<e:Label y="0" text="【Hiệu ứng Cực Phẩm】" size="20" x="0" bold="true"   textColor.lock="0xff0000"
					         textColor="0xff0000"  fontFamily="Microsoft YaHei"/>
					<e:Image source="tongyongline" y="94.34" width="289" horizontalCenter="0" height="1"/>
				</e:Group>
				<e:Group height="59" y="155.33" horizontalCenter="0.5" x="105"   includeIn="active">
					<e:Button id="btnUse" label="Kích hoạt" skinName="SkinBtn1" includeIn="active"   verticalCenter="1"
					          horizontalCenter="0" />
				</e:Group>
				<e:layout>
					<e:VerticalLayout horizontalAlign="center" gap="12" />
				</e:layout>
			</e:Group>
		</e:Group>
		<e:Group id="gainListGroup" y="300" width="350" x="0"  includeIn="lock">
			<e:Group x="0" width="350">
				<e:Label text="Cách nhận" size="20" y="15" horizontalCenter="0"  fontFamily="Microsoft YaHei" textColor="0xffffff"/>
				<e:Image source="tongyongline" scale9Grid="27,0,166,3" width="272.222" y="0" horizontalCenter="0"
				          height="1.5" visible="false"/>




			</e:Group>
			<e:List id="gainList0" itemRendererSkinName="SkinRuneGainTipsItem" x="0" y="50">
				<e:layout>
					<e:VerticalLayout gap="0" horizontalAlign="contentJustify" paddingLeft="0" paddingRight="0" />
				</e:layout>
			</e:List>
		</e:Group>
		<e:Group y="218" horizontalCenter="0" height="35">
			<e:Image source="bantoutiaobg" height="35" touchEnabled="false"  
			         scale9Grid="128,2,15,41" width="300" y="19.63"  horizontalCenter="0"/>
			<e:Label text="Chạm vùng trống để đóng cửa sổ" size="20" touchEnabled="false" y="25.63" 
			           fontFamily="Microsoft YaHei" textColor="0xffffff" horizontalCenter="0"/>
		</e:Group>
		<!--<e:Group id="powerGroup" x="32" y="143"  height="41" locked="true">
		<e:Image source="zjmzhandouli" />
	</e:Group>
	-->
	<e:layout>
		<e:VerticalLayout horizontalAlign="center" verticalAlign="middle" gap="0" />
	</e:layout>
</e:Group>
</e:Skin>