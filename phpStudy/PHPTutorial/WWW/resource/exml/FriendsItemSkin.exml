<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="SkinFriendsItem" height="95" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing" xmlns:euiextension="euiextension.*"
	xmlns:ns1="*" width="542">
	<e:Rect fillAlpha="0.2" left="0" right="0" top="0" bottom="0" touchEnabled="true"/>
	<e:Image bottom="0" left="0" right="0" top="0" source="chatbg2" scale9Grid="5,5,36,36"/>
	<e:Group verticalCenter="0.5" width="67" height="70" anchorOffsetX="0" horizontalCenter="-225.5">
		<e:Image id="img_userIcon" source="{data.userIcon}" width="59" height="59" x="3" y="3"/>
		<e:Image id="headBg" scale9Grid="5,5,3,3" top="0" source="friend_kuang" width="66" x="0" height="69"/>
	</e:Group>


	<e:Label id="label_power" size="16"   textColor="0xF7B910" left="90" top="32" bottom="10" right="60" text="{data.power}" visible="false"/>
	<e:Label id="label_lastLogin" size="18" textAlign="center" verticalAlign="middle" textColor="0xffb400" fontFamily="Microsoft YaHei" text="{data}" horizontalCenter="106.5" verticalCenter="4.5"/>
	<e:Button id="btn_bg" label="Nhắn riêng" skinName="SkinBtn1"     left="2" right="2" top="2" bottom="2" alpha="0.01"/>
<e:Group id="group_friend" anchorOffsetY="0" height="47" x="432" y="27">
		<e:Button id="btn_chat" label="Nhắn riêng" icon="friends_10" skinName="SkinBtn7" right="0" visible="false"/>
	<e:Button id="btn_delete" label="Xóa bạn" icon="friend_btnbg" right="0" width="91" height="50" scaleX="1" scaleY="1" y="0" skinName="SkinBtn25"/>
		<e:Button id="btn_blackList" label="Chặn" icon="friends_10" skinName="SkinBtn7" right="0" visible="false"/>
	</e:Group>
	<e:Group width="289" height="50" anchorOffsetY="0" anchorOffsetX="0" horizontalCenter="-40" verticalCenter="3">
		<e:Label id="label_name" text="{data.name}" size="20" y="-116" x="-2" fontFamily="Microsoft YaHei" textColor="0xabebff" scaleX="1" scaleY="1"/>
		<e:Label id="labelGuild" text="Tên Bang Hội" size="18" y="-86" x="-2" fontFamily="Microsoft YaHei" textColor="0x00ff06" scaleX="1" scaleY="1"/>
		<e:layout>
			<e:VerticalLayout verticalAlign="middle"/>
		</e:layout>
	</e:Group>
	
</e:Skin>