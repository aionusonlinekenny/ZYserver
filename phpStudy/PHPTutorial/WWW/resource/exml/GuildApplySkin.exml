		<e:Image left="0" right="0" source="tongyong_juanzhou" scale9Grid="24,0,443,17" top="0"/>
		<e:Image height="535"  source="tongyongbg5" width="475" horizontalCenter="0" verticalCenter="-41.5" scale9Grid="4,4,18,11"/>
		<e:Button id="createBtn" label="Tạo Tiên Minh" horizontalCenter="4.5" bottom="56" scaleX="1" scaleY="1" skinName="SkinBtn6" icon="btn2_2"/>
		<e:Image source="tongyong_titlebg" horizontalCenter="1" top="-17" width="281" scale9Grid="69,14,112,8"/>

		<e:Label text="Xin gia nhập Tiên Minh" size="22" y="-3.99" horizontalCenter="0.5" textColor="0x084151" fontFamily="Microsoft YaHei"/>
