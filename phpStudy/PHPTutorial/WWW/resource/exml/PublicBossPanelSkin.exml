<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="SkinPublicBossPanel" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing" width="600" height="728">
	<w:Config id="15d305f2e2d"/>



	<e:Image left="9" right="9" top="62" bottom="0" source="tongyong_dikuang4" scale9Grid="10,10,60,60" anchorOffsetY="0" anchorOffsetX="0"/>

	<e:Group width="554" horizontalCenter="0" height="30" top="28">





		<e:Label text="挑战次数：" size="20" x="15.36" fontFamily="Microsoft YaHei" textColor="0xffffff" verticalCenter="0"/>
		<e:Label id="challengeCountTxt" text="12/20" size="20" x="110.36" textAlign="center" verticalAlign="middle" fontFamily="Microsoft YaHei" textColor="0xffffff" verticalCenter="0"/>
		<e:Label id="timeTxt" text="24:24:24后恢复" size="20" textAlign="center" width="210" fontFamily="Microsoft YaHei" textColor="0xffffff" verticalCenter="0" horizontalCenter="22"/>

		<e:Label id="setting" text="提醒设置" size="20" x="444" fontFamily="Microsoft YaHei" textColor="0x00ff06" verticalCenter="0"/>


		<e:Button id="buyBtn" label="" x="176.5" y="1.66" scaleX="0.8" scaleY="0.8" visible="false">
			<e:skinName>
				<e:Skin states="up,down,disabled">
				<e:Image width="100%" height="100%" source="btnadd"/>
				<e:Label id="labelDisplay" horizontalCenter="0" verticalCenter="0"/>
				</e:Skin>
			</e:skinName>
		</e:Button>
		<e:Group id="juan" height="25.67" x="-15.49" y="-24" anchorOffsetY="0">
			<e:Image id="jicon" scaleX="1" scaleY="1" source="200156_png" width="27" height="27" x="22" y="-1"/>
			<e:Label text="野外挑战令" size="20" scaleX="1" scaleY="1" x="-1" y="0" fontFamily="Microsoft YaHei" textColor="0xffffff"/>
			<e:Label text="X" size="20" scaleX="1" scaleY="1" x="9" y="10" fontFamily="Microsoft YaHei" textColor="0x00ff00"/>
			<e:Label id="jcount" text="100" size="20" scaleX="1" scaleY="1" y="0" horizontalCenter="-38" fontFamily="Microsoft YaHei" textColor="0x00ff06"/>
			<e:layout>
				<e:HorizontalLayout horizontalAlign="center" verticalAlign="middle" gap="4"/>
			</e:layout>


		</e:Group>
	</e:Group>

    <e:Scroller id="bossScroller" width="567" horizontalCenter="0.5" top="70" bottom="7" anchorOffsetY="0" height="650">
        <e:List itemRendererSkinName="SkinBossItem" id="list" height="640" verticalCenter="1" horizontalCenter="0">
					<e:layout>
						<e:TileLayout/>
					</e:layout>

        </e:List>
    </e:Scroller>
	<e:Group id="vipGroup" width="544" height="31"   bottom="0" horizontalCenter="0">
		<e:Image    source="bantoutiaobg" left="-20" right="-20" top="0" bottom="-4" scale9Grid="179,5,19,30"/>
		<e:Label id="tipTxt" text="挑战次数不足，首充开启妖帝天宫，BOSS不限次数无限刷!" size="20"   verticalCenter="0" horizontalCenter="0" fontFamily="Microsoft YaHei" textColor="0xffff00"/>
	</e:Group>

</e:Skin>