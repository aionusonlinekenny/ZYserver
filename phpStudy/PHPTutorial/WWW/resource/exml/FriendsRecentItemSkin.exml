		<e:Image id="imgBg" scale9Grid="5,5,3,3" source="friend_kuang" width="66" x="0" height="69" y="0"/>
		<e:Image id="redPoint" source="zjmhongdian"   right="-10" top="-10" visible="false"/>
		<e:Image includeIn="down" width="70" height="70" x="-2" y="-3" source="xuanzhongkuang2" scale9Grid="4,4,8,8"/>
	</e:Group>

	
</e:Skin>