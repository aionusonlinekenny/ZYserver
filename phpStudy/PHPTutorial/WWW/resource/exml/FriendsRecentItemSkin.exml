<e:Skin class="SkinFriendsRecentItem" height="100" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing" xmlns:euiextension="euiextension.*"
	xmlns:ns1="*" width="103"  states="up,down"  width.up="103" height.up="100">
	<e:Label id="label_name" text="Tên người chơi 6 chữ" size="16" textColor="0xFFB727" horizontalCenter="0" size.up="16" horizontalCenter.up="0" horizontalCenter.down="0" y.up="72" fontFamily.up="Microsoft YaHei" y.down="72" fontFamily.down="Microsoft YaHei" textColor.up="0x00ffff" textColor.down="0xffff00"/>
	<e:Group width="70" height="70" y="0" horizontalCenter="0" y.down="2">
