<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="SkinFlowerUseTips" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing"
        xmlns:euiextension="euiextension.*" xmlns:ns1="*"  width="600" height="948">
	<w:Config id="1586b37c599" />
	<e:Rect id="bgClose" left="0" right="0" top="-1" bottom="1" fillAlpha="0.7" />
	<e:Group id="anigroup" horizontalCenter="0" verticalCenter="0" width="577" height="449">
		<e:Image id="BG"  source="flower_bg_png" horizontalCenter="0" verticalCenter="0"/>
		<e:Group horizontalCenter="0" touchEnabled="false" touchChildren="false" bottom="-49">
			<e:Image source="bantoutiaobg" height="40" width="383"/>
			<e:Label text="Chạm vùng trống để đóng cửa sổ" size="20" y="7"  fontFamily="Microsoft YaHei" horizontalCenter="0"/>
		</e:Group>


		<e:Label text="收花人：" size="22" fontFamily="Microsoft YaHei" top="124" left="90"/>
		<e:Image source="flower_nameBg" anchorOffsetX="0" width="226" height="43" top="114" horizontalCenter="-6.5" scale9Grid="8,6,17,30"/>
		<e:Label id="selectName" text="Tên người chơi 6 chữ" size="22" fontFamily="Microsoft YaHei" horizontalCenter="-7.5" top="123"/>
		<e:Group horizontalCenter="0" anchorOffsetY="0" anchorOffsetX="0" width="368" top="180">
			<e:Button id="sub1Btn" label="" skinName="SkinBtn0" icon="btn-" verticalCenter="0" left="46"/>
			<e:Button id="add1Btn" label="" skinName="SkinBtn0" icon="btnadd" right="57" verticalCenter="0"/>
			<e:Button id="maxBtn" label="最大" icon="btnmax2" skinName="SkinBtn0" verticalCenter="0" right="10"/>
			<e:Button id="minBtn" label="最小" icon="btnmax2" skinName="SkinBtn0" rotation="180" verticalCenter="0" left="0"/>
			<e:Image width="176" height="43" verticalCenter="0" anchorOffsetX="0" source="flower_nameBg" scale9Grid="8,9,17,26" horizontalCenter="-5"/>
			<e:Label id="numLabel" text="1" textAlign="center" size="30" width="90" verticalCenter="0.5" horizontalCenter="-7" fontFamily="Microsoft YaHei"/>
			</e:Group>
		<e:Label id="itemCount" text="剩余鲜花：999" size="20" horizontalCenter="-79.5" fontFamily="Microsoft YaHei" verticalCenter="27.5"/>
		<e:Label id="charmPoint" text="魅力值：10" size="20" horizontalCenter="75.5" fontFamily="Microsoft YaHei" verticalCenter="27.5"/>
		<e:Button id="sendBtn" label="送出鲜花" icon="btn2_2" horizontalCenter="-6.5" skinName="SkinBtn6" width="176" height="69" bottom="83"/>

		<e:Button id="openListBtn" label="Button" x="440" y="118" skinName="SkinBtn0" icon="btnmax2" rotation="90"/>

		<e:Button id="closeBtn" label="Button" skinName="SkinBtn0" icon="flower_closeBtn" anchorOffsetX="0" horizontalCenter="226" top="11"/>
		<e:Scroller id="scroller" anchorOffsetY="0" height="280" scrollPolicyV="on" scrollPolicyH="auto" enabled="true" top="160" horizontalCenter="-5" anchorOffsetX="0" width="230" visible="false">
			<e:List id="list" itemRendererSkinName="SkinFlowerTargetItem" left="0" top="0" right="0" bottom="0" scrollEnabled="true" anchorOffsetY="0">
					<e:layout>
					<e:VerticalLayout gap="0"/>
					</e:layout>
				</e:List>
		</e:Scroller>


	</e:Group>
</e:Skin>