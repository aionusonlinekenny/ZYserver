<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="celebrationWin" width="600" height="948" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing" xmlns:ns1="*"  >
	<e:Group top="0" bottom="0" left="0" right="0">
		<e:Rect left="0" right="0" top="0" bottom="0" fillAlpha="0.6" />
		<e:Image top="0" bottom="0" width="600" scale9Grid="15,12,2,3" horizontalCenter="0" source="vipbg_png"/>
		<e:Image width="563" horizontalCenter="0.5" scale9Grid="25,20,19,26" anchorOffsetY="0" source="vipbg4_png" top="95" bottom="182"/>



		<ns1:RoleSelectPanel id="roleSelect" skinName="SkinRoleSelectPanel" currentState="nohead" width="580" horizontalCenter="0"/>

		<e:Group width="600" top="0" horizontalCenter="0" touchEnabled="false" touchThrough="true" height="948" anchorOffsetY="0" touchChildren="false">

			<e:Image y="1.36" source="shang_2_png" width="276" height="98" anchorOffsetX="0" left="0"/>

			<e:Image source="shang_3_png" scaleX="1" top="34" left="70"/>
			<e:Image id="title0" top="15" scaleX="1" left="47" source="biaoti_beizhandianfeng_png"/>
		</e:Group>
		<e:ViewStack id="viewStack" width="560" selectedIndex="0" horizontalCenter="0" anchorOffsetY="0" top="95" bottom="182">
			<ns1:BaseComponent id="CELogPanel" left="0" right="0" top="0" bottom="0" skinName="CELogSkin"/>

			<ns1:BaseComponent id="CETreasurePanel" left="0" right="0" top="0" bottom="0" skinName="CETreasureSkin" visible="false"/>
			<ns1:BaseComponent id="CERechargePanel" left="0" right="0" top="0" bottom="0" skinName="CERechargeSkin" visible="false"/>
			<ns1:BaseComponent id="ISCostRankPanel" left="0" right="0" top="0" bottom="0" skinName="ISCostRankSkin" visible="false"/>
			<ns1:BaseComponent id="CEGiftPanel" left="0" right="0" top="0" bottom="0" skinName="OSAGift" visible="false"/>
			<ns1:BaseComponent id="CELimitGiftPanel" left="0" right="0" top="0" bottom="0" skinName="OSADailyGiftSkin" visible="false"/>
			<ns1:BaseComponent id="CEBossPanel" left="0" right="0" top="0" bottom="0" x="10" y="10" skinName="CEBossSkin" visible="false"/>
		</e:ViewStack>


		<e:Scroller id="menuScroller" scrollPolicyV="off" scrollPolicyH="on" height="106" horizontalCenter="1" width="450" bottom="78">
			<e:List id="menuList" itemRendererSkinName="SkinActBtn" scrollEnabled="false">
			<e:layout>
				<e:HorizontalLayout paddingLeft="0" horizontalAlign="center" paddingTop="0" gap="0"/>
			</e:layout>
			</e:List>
		</e:Scroller>
	</e:Group>
	<e:Button id="closeBtn" label="Nút bấm" skinName="SkinBtn0" icon="chatclose" y="44" scaleX="1" scaleY="1" horizontalCenter="273"/>
	<e:Group horizontalCenter="265.5" width="67" bottom="105">
		<e:Button id="rightBtn" label="" icon="jiantouxuan" skinName="SkinBtn0" scaleX="-1" scaleY="1" x="58"/>
		<e:Image id="rightRed" x="21" y="-8" source="zjmhongdian" touchEnabled="false"/>
	</e:Group>
	<e:Group horizontalCenter="-252.5" bottom="105">
		<e:Button id="leftBtn" label="" icon="jiantouxuan" skinName="SkinBtn0" scaleX="1" scaleY="1" />
		<e:Image id="leftRed" x="20" y="-8" source="zjmhongdian" touchEnabled="false"/>
	</e:Group>		
</e:Skin>