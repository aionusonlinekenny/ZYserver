<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="skinladderresultwin" width="600" height="948" xmlns:e="http://ns.egret.com/eui"
        xmlns:w="http://ns.egret.com/wing" xmlns:ns1="*">
	<e:Rect fillAlpha="0.6" left="0" right="0" top="0" bottom="0"/>
	<e:Group id="container" horizontalCenter="0" width="600" height="948" y="0">
		<e:Image id="bg"   left="0" right="0" top="0" bottom="0" height="948" scale9Grid="3,4,26,36" source="tongyong_bgsuc"/>
		<e:Image width="600" height="785" horizontalCenter="0" top="0" source="guang2_png"/>
		<e:Scroller width="280" height="108"     x="216" y="566">
			<e:List id="list" itemRenderer="ItemBase" height="108"  width="280" horizontalCenter="2" verticalCenter="2" itemRendererSkinName="SkinItem2">
				<e:layout>
					<e:HorizontalLayout gap="42"/>
				</e:layout>

			</e:List>
		</e:Scroller>
		<e:Image id="result" y="49"   source="labwin_png" horizontalCenter="28"/>
		<ns1:LadderStarListView id="starList" y="310" skinName="SkinLadderSratList" horizontalCenter="0"/>
		<e:Label text="Thưởng thách đấu：" y="586" fontFamily="Microsoft YaHei" size="20" x="106"/>
		<e:Button id="sureBtn" label="Nhận thưởng" width="213" horizontalCenter="0" y="690" skinName="SkinBtn7" height="67"/>
		<e:Group id="upStar" width="237" height="50" y="498"   x="106">
			<e:Label text="星级奖励：" x="0" y="17" size="20" fontFamily="Microsoft YaHei"/>
			<ns1:LadderStarView id="star1" x="96" y="4" skinName="SkinLadderSrat"/>
			<ns1:LadderStarView id="star2" x="136" y="4" skinName="SkinLadderSrat"/>
		</e:Group>
		<e:Label id="leavetime" text="2s" y="758" fontFamily="Microsoft YaHei" size="30" textColor="0x00ff06" textAlign="center" horizontalCenter="0"/>
		<e:Button id="closeBtn" label="Button" x="10" y="776" skinName="SkinBtn0" icon="tuichu" visible="false"/>
	</e:Group>
</e:Skin>