<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="SkinWpkBossUi" currentState="normal" xmlns:e="http://ns.egret.com/eui"
        xmlns:w="http://ns.egret.com/wing" xmlns:ns1="*" width="600" height="948">
	<w:Config id="15c6d0f73d2" />
	<e:Group id="attList" width="100" top="176" bottom="144" x="0" visible="false">
		<e:Button id="refush" label="按钮" y="0" skinName="SkinBtn0" width="80"  horizontalCenter="0" visible="false"/>

		<e:Group id="beAttackGroup" x="0" top="151" bottom="0">
			<e:Group x="0" y="0" width="100">
				<e:Image source="teshuwenzibg" y="0" height="30" left="0" right="0" />
				<e:Label text="受到攻击" y="5" size="18" textAlign="center" textColor="0xd6240e" x="14" />
			</e:Group>
			<e:Scroller id="bar1" width="100" x="0" top="32" bottom="0">
				<e:List id="list2" x="5" y="6" itemRendererSkinName="SkinMemberHead">
				</e:List>
			</e:Scroller>
		</e:Group>
		<e:Group id="attackGroup" x="0" y="1">
			<e:Group x="0" y="0" width="100">
				<e:Image source="teshuwenzibg" y="0" height="30" left="0" right="0" />
				<e:Label text="正在攻击" y="5" size="18" textColor="0xFFCE0B" textAlign="center" x="14" />
			</e:Group>
			<e:List id="list1" width="100" height="110" x="0" y="30"  
			        itemRendererSkinName="SkinMemberHead">
			</e:List>
		</e:Group>
	</e:Group>
	<e:Group id="leftTimeGroup" horizontalCenter="0" y="3" width="340" height="33">
		<e:Image left="0" right="0" top="0" bottom="0"  source="Gwshkuang" scale9Grid="23,5,81,19"/>
		<e:Group y="6" horizontalCenter="0">
			<e:Label text="活动剩余时间:" x="0" y="0" size="18"  fontFamily="Microsoft YaHei" textColor="0xffffff"/>
			<e:Label id="lastTime" text="15分00秒" x="111" y="0" size="18" rotation="359.27"  fontFamily="Microsoft YaHei" textColor="0x00ff00"/>
			<e:layout>
				<e:HorizontalLayout gap="2" />
			</e:layout>
		</e:Group>
	</e:Group>
	<e:Group id="bossBloodGroup" y="20" horizontalCenter="0">
		<e:Rect height="20" y="50" left="110" right="30" fillColor="0x111010"  visible="false"/>
		<e:Rect width="82" height="82" x="17" y="19" ellipseWidth="82" ellipseHeight="82" fillColor="0x111010"  visible="false"/>
		<e:Group id="hudun" x="89" y="74" width="186">
			<e:Rect left="13" right="13" top="0" bottom="10" fillColor="0x111010" visible="false"/>
			<e:Image x="0" y="0" scale9Grid="15,1,13,3" source="zdbosshudunxuetiaobg"/>
			<e:ProgressBar id="hudunbloodBar" width="176" height="8" value="100" x="1" y="2" skinName="Skinbar9"/>
		</e:Group>

		<e:Image x="66.5" y="30" source="bosstouxiangjinbian"/>
		<e:Image x="66.5" y="92" source="bosstouxiangjinbian" scaleY="-1"/>
		<e:Image y="49" x="90" source="rolebloodbg" scale9Grid="33,3,201,18"/>
		<e:Image x="27.5" y="28.5" source="guildkuangbg" scaleX="0.75" scaleY="0.75"/>
		<e:Image id="head" y="27.5" x="25" source=""/>
		<e:Image id="grayImg" y="51" source="bosshp2" width="263" x="91"/>
		<e:ProgressBar id="bloodBar" y="50.5" value="50" skinName="Skinbar7" x="91" width="263" height="21"/>
		<e:Label id="bossBloodPercentageLabel" text="100%" x="194.1" y="52.5" fontFamily="Microsoft YaHei" size="18"/>
		<e:Image width="69" height="71" x="24.33" y="26.33" source="guildkuang"/>

		<e:Button id="tipBtn0" label="奖励" x="31" y="97" skinName="SkinBtn0" icon="bosstouxiangbtn"/>

		<e:Label id="lvTxt" y="28" size="20" text="Lv.600" x="96" width="65" textAlign="right"  fontFamily="Microsoft YaHei" anchorOffsetX="0" textColor="0xffff00"/>
		<e:Label id="nameTxt" y="28" size="18" text="祖玛教主" x="162"  fontFamily="Microsoft YaHei" textColor="0xffffff" textAlign="left"/>
		<e:Label id="myTxt" y="30" size="16" text="自己: 10" x="288" fontFamily="Microsoft YaHei" textColor="0xffffff"/>
		<e:Button id="tipBtn" label="奖励" x="31" y="98" skinName="SkinBtn0" icon="bosstouxiangbtn" visible="false"/>
	</e:Group>


	<e:Group id="attEffectGroup" left="0" right="0" top="0" bottom="0" touchChildren="false" touchEnabled="false" alpha="0" visible="false">
		<e:Image source="shoujihong" scale9Grid="8,2,54,2" top="0" bottom="0" touchEnabled="false" left="0" />
		<e:Image source="shoujihong" scale9Grid="8,2,54,2" scaleX="-1" top="0" bottom="0" touchEnabled="false"
		         right="0" />
	</e:Group>

	<e:Group id="attList0" width="106" right="0" top="176" bottom="140" visible="false">

		<e:Image source="teshuwenzibg" height="30" left="0" right="0"/>
		<e:Button id="refush0" label="按钮" y="0" skinName="SkinBtn0" width="100" horizontalCenter="0" visible="false"/>
		<e:Label text="选择目标" y="6" size="16" strokeColor="0x000000" textColor="0xD1C28F" bold="true" horizontalCenter="0" touchEnabled="false"/>
		<e:Scroller id="bar0" scaleX="0.9" scaleY="0.9" horizontalCenter="0" width="100" top="34" bottom="0">
		<e:List id="list0" x="5" y="6" itemRendererSkinName="SkinMemberHead">
		</e:List>
		</e:Scroller>
	</e:Group>
	<ns1:DropDown id="dropDown" y="120" skinName="SkinDropDown" right="0"/>
	<e:Group bottom="158" horizontalCenter="20" width="368">
		<e:Image alpha="1" source="guildwarbg" scale9Grid="1,14,115,19" width="338" x="30" height="86" y="0"/>
		<e:Group id="timeGroup" x="78" y="2" height="38">
			<e:Group id="costGroup" y="0" x="0">
				<e:Image id="typeImg" x="12" y="0" source="szyuanbao"/>
				<e:Label id="cost" text="10000" x="0" size="18" y="7" stroke="1" fontFamily="Microsoft YaHei" textColor="0xffff00"/>
				<e:layout>
				<e:HorizontalLayout verticalAlign="middle" gap="0"/>
				</e:layout>
			</e:Group>
			<e:Group id="countGroup" x="84" y="2">
				<e:Label text="鼓舞次数：" size="18" x="0" y="0" fontFamily="Microsoft YaHei" textColor="0xffffff"/>
				<e:Label id="guwutime" text="0/20" size="18" x="0" y="0" fontFamily="Microsoft YaHei" textColor="0xffffff"/>
				<e:layout>
				<e:HorizontalLayout gap="-4"/>
				</e:layout>
			</e:Group>
			<e:layout>
				<e:HorizontalLayout verticalAlign="middle" gap="8"/>
			</e:layout>
		</e:Group>
		<e:Label id="guwuNum" text="攻击:10000+20000\n攻击:0+10%" size="18" x="102" y="41" fontFamily="Microsoft YaHei" textColor="0xffffff" lineSpacing="4"/>

		<e:Button id="guwu" skinName="SkinBtn0" icon="guwu" x="0" y="-3"/>
	</e:Group>
</e:Skin>