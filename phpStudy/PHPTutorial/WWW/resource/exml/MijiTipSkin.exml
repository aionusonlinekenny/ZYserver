<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="SkinMijiTip" width="480" height="800" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing" xmlns:euiextension="euiextension.*"
	xmlns:ns1="*">
	<e:Rect id="colorCanvas" fillAlpha="0.8" left="0" right="0" top="0" bottom="0"/>
	<e:Group id="group" height="200" width="350" verticalCenter="0" horizontalCenter="0">
		<e:Image source="tongyongtip1" left="0" right="0" top="0" bottom="0" scale9Grid="10,10,42,9"/>
		<e:Image source="tongyongtip2" left="0" right="0" top="0" bottom="0" scale9Grid="18,18,42,4"/>
		<e:Label id="power" text="评分：" y="10" size="18" right="20" textAlign="right" fontFamily="Microsoft YaHei" textColor="0xffff00"/>
		<e:Label id="info" text="" size="18" x="90" lineSpacing="0" width="240" wordWrap="true" multiline="true" y="65" fontFamily="Microsoft YaHei" textColor="0x6b9baa"/>
		<ns1:MijiItem id="item" x="10" skinName="SkinMijiItem" scaleX="0.8" scaleY="0.8" y="40"/>
		<e:Image source="bantoutiaobg" height="35" scale9Grid="128,2,15,41" width="300" x="25" y="205"/>
		<e:Label text="Chạm vùng trống để đóng cửa sổ" size="20" x="73" y="211" fontFamily="Microsoft YaHei" textColor="0xffffff"/>
	</e:Group>
</e:Skin>