<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="SkinBlackMarket" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing" width="560" height="654">
	<e:Image bottom="0" left="0" source="shopbn2_png" anchorOffsetX="0" anchorOffsetY="0"/>



	<e:Label id="tip" text="Làm mới miễn phí：" size="20" width="320" textAlign="center" horizontalCenter="108" fontFamily="Microsoft YaHei" bottom="119"/>


	<e:Button id="buyAllItemBtn" label="Mua hết" width="120" height="52" horizontalCenter="-75" bottom="1" icon="chat_btnbg" skinName="SkinBtn26"/>
	<e:Button id="refreshShopBtn" label="Làm mới" width="120" height="52" icon="chat_btnbg" horizontalCenter="75" bottom="1" skinName="SkinBtn26"/>
	<e:Image id="redPoint" source="zjmhongdian" horizontalCenter="126" bottom="33" visible="false"/>
	<e:Label id="noGoods" text=" Sản phẩm đã bán hết, vui lòng làm mới" size="28" horizontalCenter="0" verticalCenter="-88" fontFamily="Microsoft YaHei" textColor="0xffff00" visible="false"/>


	<e:Label id="point" text="Điểm của tôi：20000" x="105" width="213" size="20"  textAlign="left" bottom="15" visible="false"/>
	<e:Group id="costGroup" bottom="55" horizontalCenter="93" anchorOffsetX="0" width="210">
		<e:Group x="12" y="6">
			<e:Image x="6" bottom="68" source="szyuanbao" y="3"/>
			<e:Label id="price" text="2000" x="38" size="20" bottom="69" y="4" fontFamily="Microsoft YaHei" textColor="0xffff00"/>
			<e:layout>
			<e:HorizontalLayout gap="3" verticalAlign="middle"/>
			</e:layout>
		</e:Group>
		<e:Label text="hoặc" x="100" size="20" bottom="69" y="10" fontFamily="Microsoft YaHei"/>
		<e:Group x="122" y="6">
			<e:Image source="201002_png" x="3" y="-3" anchorOffsetX="0" width="30" anchorOffsetY="0" height="30"/>
			<e:Label id="keylabel" text="0" x="30" size="20" bottom="70" y="5" fontFamily="Microsoft YaHei" textColor="0xe40000"/>
			<e:Label text="/1" x="40" size="20" bottom="70" y="15" fontFamily="Microsoft YaHei" textColor="0xffff00"/>
			<e:layout>
			<e:HorizontalLayout gap="3" verticalAlign="middle"/>
			</e:layout>
		</e:Group>
		<e:layout>
			<e:HorizontalLayout verticalAlign="middle" gap="4"/>
		</e:layout>
	</e:Group>
	<e:Scroller width="514.55" anchorOffsetY="0" anchorOffsetX="0" top="7" bottom="146" horizontalCenter="2.5">
		<e:List id="listView" itemRendererSkinName="BlackMarketItem">
		<e:layout>
			<e:VerticalLayout gap="1"/>
		</e:layout>
		</e:List>
	</e:Scroller>
	<e:Label id="goodsOverView" text="Xem trước Cực Phẩm" size="20" horizontalCenter="118" bottom="100" verticalAlign="middle" textAlign="center" fontFamily="Microsoft YaHei" textColor="0x00ff00"/>
 
</e:Skin>