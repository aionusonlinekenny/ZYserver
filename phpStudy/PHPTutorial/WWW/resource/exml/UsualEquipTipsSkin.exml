<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="SkinUsualEquipTips" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing" xmlns:euiextension="euiextension.*"
	xmlns:ns1="*" width="580" height="930">

	<e:Rect id="bgClose" fillAlpha="0.8" left="0" right="0" top="0" bottom="0"/>
	<e:Group id="anigroup" width="350" horizontalCenter="0" verticalCenter="5.5" touchEnabled="false" anchorOffsetY="0" height="474.99">
		<e:Image id="background" source="tongyongtip1" scale9Grid="7,6,11,12" left="0" right="0" top="2" bottom="0" touchEnabled="false"/>
		<e:Image id="quali" source="quali1_png" left="0" right="0" anchorOffsetY="0" scale9Grid="10,18,8,422" top="2" height="523"/>

		<e:Image y="140" width="340" horizontalCenter="0" height="45" source="bantoutiaobg8" scale9Grid="147,1,19,38"/>
		<e:Label id="nameLabel" text="Đồ Long " size="20" textAlign="left" textColor="0x90f490" y="20" x="20" fontFamily="Microsoft YaHei"/>
		<e:Group x="20" y="52">
			<ns1:ItemIcon id="itemIcon" skinName="SkinItemIcon" x="0" y="0"/>
			<e:Group verticalCenter="0" left="100">
				<e:Label id="typeName" y="0" text="Vị trí：" size="18" x="0" fontFamily="Microsoft YaHei" textColor="0x6b9baa" lineSpacing="5"/>
				<e:Label id="typeValue" y="0" text="Vũ khí" size="18" x="60" fontFamily="Microsoft YaHei" textColor="0xffffff" lineSpacing="5"/>
				<e:layout>
				<e:HorizontalLayout gap="0"/>
				</e:layout>
			</e:Group>
		</e:Group>
		<e:Group id="content" top="203" bottom="15" left="24">
			<e:layout>
			<e:VerticalLayout gap="5"/>
			</e:layout>
		</e:Group>
		<e:Group horizontalCenter="0" bottom="-43">
			<e:Image source="bantoutiaobg" height="35" width="338" touchEnabled="false" x="0" y="3" scale9Grid="169,6,28,26"/>
			<e:Label text="Chạm vùng trống để đóng cửa sổ" size="20" x="58" touchEnabled="false" y="9" fontFamily="Microsoft YaHei" textColor="0xffffff"/>
		</e:Group>
		<ns1:PowerPanel id="powerPanel" y="130" x="24" skinName="Skin2PowerPanel"/>
		<e:Label id="score" text="" size="18" y="20" textAlign="right" right="20" width="200" fontFamily="Microsoft YaHei" textColor="0xffff00"/>
		<e:Button id="changeBtn" label="更换装备" skinName="SkinBtn1" horizontalCenter="0" bottom="-106" x="110" y="500" width="180" height="60"/>
	</e:Group>
</e:Skin>