        xmlns:euiextension="euiextension.*" xmlns:ns1="*" width="600" height="948">
	<w:Config id="1586b3502a7" />
	<e:Rect id="bgClose" fillAlpha="0.6" top="-1" left="-1" right="1" bottom="1" />

	<e:Group id="group" horizontalCenter="0" verticalCenter="0" width="344" height="586">
		<e:Group id="mcGroup" y="-24" horizontalCenter="0" width="344" height="546" anchorOffsetY="0">
		<e:Image id="background" source="tongyongtip1" scale9Grid="11,6,42,59" width="347" height="540" horizontalCenter="0" top="0"/>
			<e:Image id="qualityImg" top="1" y="2" source="quali4" width="345" horizontalCenter="0" scale9Grid="9,0,11,0"/>
		<e:Image scale9Grid="1,355,393,157" horizontalCenter="0" source="heartmethodbookbg_png" verticalCenter="0"/>


		<e:Label id="nameLabel" text="无影·上篇" size="30" textAlign="left" top="10" y="20" horizontalCenter="0.5" fontFamily="Microsoft YaHei" textColor="0xff0000"/>
			<e:Group width="344" height="60" id="starGroup" scaleX="0.8" scaleY="0.8" horizontalCenter="0" top="47"/>
		<e:Image y="288" width="340" x="5" source="longhuntextbg"/>
			<e:Group id="ModelGroup"  horizontalCenter="0" verticalCenter="-113">
				<e:Image id="icon" source="wydbigicon1_png" horizontalCenter="0" verticalCenter="0"/>
				<e:Group id="effGroup" verticalCenter="-4.5" horizontalCenter="2.5"/>
			</e:Group>
		<ns1:PowerPanel id="powerPanel" skinName="SkinPowerPanel" horizontalCenter="0" verticalCenter="34"/>
		<e:Group horizontalCenter="0" verticalCenter="114">
			<e:Group y="0" width="325" horizontalCenter="0" x="0" height="116">
			<e:Label id="attr" text="生       命：\n攻       击：\n物       防：\n魔       防：" size="20" verticalAlign="justify" x="41" textAlign="left" verticalCenter="0" fontFamily="Microsoft YaHei" textColor="0x00ffff"/>
			<e:Label id="value" text="+1000\n+2000\n+3000\n+4000" size="20" verticalAlign="justify" x="141" textAlign="left" verticalCenter="0" fontFamily="Microsoft YaHei" textColor="0xffffff"/>






			<e:Image source="tongyongline" y="117" width="289" horizontalCenter="0" scale9Grid="109,0,12,3" height="1"/>
			</e:Group>
			<e:Group y="120" width="325" horizontalCenter="0" x="0" height="30">
