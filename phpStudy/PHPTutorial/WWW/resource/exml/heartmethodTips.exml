				<e:Button id="replace" label="替 换" icon="xb_26" skinName="SkinBtn1" width="130" height="50" x="195" y="0"/>
				<e:Image id="redPoint2" source="zjmhongdian" horizontalCenter="159.5" verticalCenter="-21.5"/>

