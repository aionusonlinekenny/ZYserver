			<e:layout>
				<e:HorizontalLayout verticalAlign="bottom"/>
			</e:layout>
			</e:Group>
			<e:layout>
			<e:VerticalLayout horizontalAlign="center" gap="6"/>
			</e:layout>
		</e:Group>
			<e:Group id="btn" width="326" height="46" horizontalCenter="0" anchorOffsetY="0" verticalCenter="223">
				<e:Button id="addStar" label="升星" icon="xb_25" skinName="SkinBtn1" width="130" height="50" horizontalCenter="-98" y="0"/>
