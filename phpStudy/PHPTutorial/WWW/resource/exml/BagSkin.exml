<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="SkinBag" width="600" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing" xmlns:euiextension="euiextension.*"
	xmlns:ns1="*"  height="948">
	<w:Config id="1586b349dbe"/>
	<e:Rect width="600" fillColor="0x0d97ae" horizontalCenter="0" top="0" bottom="0"/>
  	<e:Image horizontalCenter="0" verticalCenter="-35" source="bg_1_jpg"/>








	<ns1:RoleSelectPanel id="roleSelect" currentState="nohead" top="0" horizontalCenter="0" width="600" skinName="SkinRoleSelectPanel"/>


	<e:ViewStack id="viewStack" width="584" selectedIndex="2" horizontalCenter="0" top="110" bottom="250">
		<e:Group name="装备" top="0" bottom="0" horizontalCenter="0">
			<e:Image scale9Grid="19,12,10,20" anchorOffsetY="0" anchorOffsetX="0" width="584" top="0" bottom="0" horizontalCenter="0" source="tongyong_dikuang4"/>
