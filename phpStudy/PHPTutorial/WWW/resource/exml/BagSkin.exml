			<e:Image scale9Grid="6,6,3,3" source="shuzibg" width="132" height="37" x="80" bottom="-70"/>
			<e:Label id="itemCount" text="100" size="22" width="131" x="81" height="38" textAlign="center" verticalAlign="middle" textColor="0xffffff" bottom="-70"/>
			<e:Scroller id="itemScroller" left="0" right="0" top="0" bottom="3" height="593" anchorOffsetY="0">
			<e:List id="itemList" x="-1" scrollEnabled="true" top="0" bottom="0" itemRendererSkinName="SkinItem3">
				<e:layout>
				<e:TileLayout paddingLeft="35" requestedColumnCount="5" rowAlign="top" paddingTop="21" horizontalGap="35" verticalGap="14" paddingRight="0"/>
				</e:layout>
			</e:List>
			</e:Scroller>

		</e:Group>
		<e:Group name="道具" left="0" right="0" top="0" bottom="0">
			<e:Image scale9Grid="19,12,10,20" source="tongyong_dikuang3" anchorOffsetY="0" anchorOffsetX="0" width="584" horizontalCenter="0" top="0" x="0" bottom="2"/>
			<e:Scroller id="itemGoodsScroller" left="0" right="0" top="0" bottom="3" height="670" anchorOffsetY="0">
			<e:List id="itemListGoods" x="0" y="0" itemRendererSkinName="SkinItem3" scrollEnabled="true" top="0" bottom="90" height="670">
				<e:layout>
				<e:TileLayout paddingLeft="35" requestedColumnCount="5" rowAlign="top" paddingTop="21" horizontalGap="35" verticalGap="14" paddingRight="0"/>
				</e:layout>
			</e:List>
			</e:Scroller>
		</e:Group>
