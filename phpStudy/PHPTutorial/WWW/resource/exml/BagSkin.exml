			<e:Image scale9Grid="19,12,10,20" source="tongyong_dikuang3" anchorOffsetY="0" anchorOffsetX="0" width="584" horizontalCenter="0" top="0" x="0" bottom="2"/>
			<e:Scroller top="0" bottom="3" left="0" right="0">
			<e:List id="itemListRune" x="12" y="12" itemRendererSkinName="SkinItem3" scrollEnabled="true" top="0" bottom="0">
				<e:layout>
				<e:TileLayout paddingLeft="35" requestedColumnCount="5" rowAlign="top" paddingTop="21" horizontalGap="35" verticalGap="14" paddingRight="0"/>
				</e:layout>
			</e:List>
			</e:Scroller>
		</e:Group>
		<ns1:ComposeComPanel id="reinComposePanel" name="合成" skinName="SkinReinCompose" left="0" right="0" top="0" bottom="0"/>
