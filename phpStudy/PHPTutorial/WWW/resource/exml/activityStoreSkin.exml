<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="activityStoreSkin" currentState="activityStore" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing" width="560" height="620" states="activityStore,integralStore" >

	<e:Group id="costGroup" bottom="0" width="270" height="93" horizontalCenter="145" includeIn="activityStore">
		<e:Image x="-1" source="szyuanbao" y="2" />
		<e:Label id="price" text="200" x="28" size="20" textColor="0xf8b141" y="3" textAlign="left"/>
		<e:Label id="or" text="hoặc" x="63" size="20" textColor="0xF8B141" y="3" textAlign="left"/>
		<e:Image id="refreshItem" x="85" source="szyuanbao" y="2" width="30" height="22"/>
		<e:Label id="refreshItemNum" text="2" size="20" y="3" textAlign="center" textColor="0x41F843" horizontalCenter="-2"/>
		<e:Label id="num" text="/1" x="151" size="20" textColor="0xF8B141" y="3" textAlign="left"/>
		<e:Label id="refreshTime" text="00:00:00" size="20" width="108" textAlign="center" height="36" verticalAlign="middle" visible.integralStore="false" x="162" y="-6" textColor="0x7E6437"/>
		<e:Label id="refreshTips" text="sau đó làm mới miễn phí" size="20" width="108" textAlign="center" height="36" verticalAlign="middle" visible.integralStore="false" y="14" x="160" textColor="0x7E6437"/>
		<e:layout>
		<e:BasicLayout/>
		</e:layout>
	</e:Group>





	<e:Label id="integralTips" text="Cửa hàng sự kiện: mỗi 1 Nguyên Bảo tiêu hao nhận 1 điểm\n\nSau khi sự kiện kết thúc điểm sẽ được reset" size="20" bottom="25" textAlign="center" verticalAlign="middle" width="290" height="61" visible.activityStore="false" right="2" textColor="0xF8B141"/>



	<e:Button id="integralStoreBtn" label="Cửa hàng Điểm" width="130" height="50" bottom="16" horizontalCenter="-91" label.integralStore="Cửa hàng Sự kiện" skinName="SkinBtn16"/>
	<e:Button id="refreshShopBtn" label="Làm mới" width="130" height="50" bottom="16" horizontalCenter="91" skinName="SkinBtn16"/>
	<e:Image id="redPoint1" source="zjmhongdian" horizontalCenter="137" bottom="45" includeIn="activityStore"/>
	<e:Image id="redPoint0" source="zjmhongdian" horizontalCenter="-48" bottom="49" includeIn="activityStore"/>

	<e:Label id="noGoods" text=" Sản phẩm đã bán hết, vui lòng làm mới" size="24" textColor="0xFF8534" horizontalCenter="0" verticalCenter="0" visible="false"/>


	<e:Label id="point" text="Điểm của tôi：20000" x="105" width="213" size="20"  textAlign="left" bottom="15" visible="false"/>

	<e:Group id="integral" horizontalCenter="-122" width="86" height="22" bottom="67">
		<e:Label id="integralName" text="Điểm hiện tại：" x="0" size="20" y="0" textColor="0x35E62D" verticalAlign="middle"/>
		<e:Label id="integralNum" text="2000" x="0" size="20" y="0" textColor="0x35E62D"/>
		<e:layout>
			<e:HorizontalLayout gap="-6"/>
		</e:layout>
	</e:Group>
	<e:Scroller width="552" horizontalCenter="0" height="373" y="154">
				<e:List id="listView" x="54" y="37" itemRendererSkinName="activityStoreItem">
					<e:layout>
						<e:TileLayout/>
					</e:layout>

		</e:List>
	</e:Scroller>
	<e:Label id="goodsOverView" text="Xem trước Cực Phẩm" size="20" bottom="11" verticalAlign="middle" textAlign="center" touchEnabled="true" right="17" textColor="0x35E62D" includeIn="activityStore"/>
	<e:Image id="title" y="0" horizontalCenter="0" source="biaoti_activityStore"/>
	<e:Group id="infoBg" left="3" right="3" x="10" y="36" height="116">
		<e:Image top="0" bottom="0" source="ny_curtain_png" right="0" left="0"/>
		<e:Group left="28" y="30">
		<e:Label text="Thời gian còn lại: " size="18" textColor="0xFF9900" left="0" top="0"/>
		<e:Label id="actTime0" text="6 ngày 23 giờ 55 phút" size="18" textColor="0x00FF00" top="0" left="90"/>
		<e:Label id="actInfo0" text="Trong thời gian sự kiện mở server, người đầu tiên đạt cấp độ chỉ định sẽ nhận phần thưởng giới hạn." x="63" y="-14" size="18" width="396" top="20" left="90" textColor="0xDFD1B5" />
		<e:Label text="Mô tả sự kiện：" size="18" textColor="0xFF9900" left="0" top="20"/>
		</e:Group>
	</e:Group> 
</e:Skin>