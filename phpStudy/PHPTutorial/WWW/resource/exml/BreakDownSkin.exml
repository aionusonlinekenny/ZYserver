<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="SkinBreakDown" xmlns:e="http://ns.egret.com/eui"
        xmlns:w="http://ns.egret.com/wing" xmlns:euiextension="euiextension.*" xmlns:ns1="*" width="600" height="948">
	<e:Rect id="bgClose" left="0" right="0" top="0" bottom="0" fillAlpha="0.8" width="600" height="948"/>
	<e:Group id="anigroup" width="580" height="654" horizontalCenter="0" verticalCenter="3">


		<e:Image id="frame" scale9Grid="26,18,1,1" width="580" source="tongyong_dikuang2" height="628" horizontalCenter="0" top="26"/>

		<e:Image id="tou" width="580" source="tongyong_juanzhou" horizontalCenter="0" top="16"/>
		<e:Image width="249" height="41" source="tongyong_titlebg" horizontalCenter="-0.5" top="0"/>
		<e:Image y="57" source="tongyong_dikuang1" x="33" height="577" width="515" scale9Grid="10,6,60,42"/>



		<e:Scroller id="equipScroller" width="505"   horizontalCenter="0" height="567" y="62">
			<e:List id="equipList" x="94.5" y="21.5" itemRendererSkinName="BreakDownItem" width="505" height="567">
			<e:layout>
				<e:VerticalLayout gap="2"/>
			</e:layout>
			</e:List>
		</e:Scroller>


		<e:Group id="contrain" width="503" height="565" horizontalCenter="1.5" anchorOffsetX="0" anchorOffsetY="0" top="63" visible="false">
			<e:Group id="listGroupTxt" y="390" touchEnabled="false" width="420" horizontalCenter="0">
				<e:Image height="18" source="diwen6" width="339" horizontalCenter="0" y="12"/>
				<e:Label text="Cách nhận" size="20" horizontalCenter="0" y="2" fontFamily="Microsoft YaHei" textColor="0x001828"/>
			</e:Group>
			<e:Scroller width="480" height="128" y="430" anchorOffsetY="0" x="11">
				<e:Group>
					<e:List id="gainList" left="0" right="0" top="0" bottom="0" width="480" height="128">
						<e:layout>
							<e:VerticalLayout gap="3"/>
						</e:layout>
					</e:List>
				</e:Group>
			</e:Scroller>
			<e:Label text="Không có trang bị nào để phân giải\nHãy thử các cách nhận bên dưới" y="145" size="20" horizontalCenter="0" fontFamily="Microsoft YaHei" x="116" textColor="0x001828"/>
		</e:Group>
		<e:Label text="Phân giải" y="12"   horizontalCenter="0" size="24" textColor="0x084151" fontFamily="Microsoft YaHei"/>
		<e:Group bottom="-43" horizontalCenter="0" x="140" y="804">
			<e:Image source="bantoutiaobg" height="35" scale9Grid="128,2,15,41" width="300" touchEnabled="false" y="-6" horizontalCenter="0"/>
			<e:Label text="Chạm vùng trống để đóng cửa sổ" size="20" touchEnabled="false" fontFamily="Microsoft YaHei" horizontalCenter="0"/>
		</e:Group>
		<e:Button id="btnClose" label="Button" x="527" y="6" skinName="SkinBtn0" icon="tongyong_btnclose"/>
	</e:Group>
	
	
</e:Skin>