		<e:Button id="closeBtn" label="按钮" skinName="SkinBtn0" icon="tongyong_btnclose" scaleX="0.8" scaleY="0.8" top="-11" right="2"/>



		<e:Group id="attr" width="516" height="200" horizontalCenter="0" verticalCenter="16.5" anchorOffsetY="0">
			<e:Image id="attrBg" anchorOffsetX="0" anchorOffsetY="0" height="193" width="516" source="hgsjtextbg" scale9Grid="109,15,122,19" horizontalCenter="0" top="0"/>
			<e:Image id="jiantou" source="jiantouyou" horizontalCenter="0.5" verticalCenter="-20"/>

			<e:Group id="nowAttr" anchorOffsetX="0" width="197" horizontalCenter="-129.5" height="180" top="5">

				<e:Label id="attrNowText" text="当 前" y="0" size="20" horizontalCenter="0" textColor="0xffff00" fontFamily="Microsoft YaHei"/>
				<e:Group id="nowFightGroup" horizontalCenter="0" scaleX="0.75" scaleY="0.75" top="128">
					<ns1:PowerPanel id="powerPanel0" skinName="SkinPowerPanel"/>
