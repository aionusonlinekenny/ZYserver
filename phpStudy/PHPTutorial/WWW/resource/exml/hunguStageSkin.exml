				<e:Label id="attr1Now0" text="Công kích：xxx" y="30" size="20" fontFamily="Microsoft YaHei" textColor="0xffffff" textAlign="left" left="45"/>
				<e:Label id="attr2Now0" text="Công kích：xxx" y="57" size="20" fontFamily="Microsoft YaHei" textColor="0xffffff" textAlign="left" left="45" visible="false"/>
				<e:Label id="attr3Now0" text="Công kích：xxx" y="84" size="20" fontFamily="Microsoft YaHei" textColor="0xffffff" textAlign="left" left="45" visible="false"/>
