	<w:Declarations></w:Declarations>
	<w:Config id="158995f2c90"></w:Config>
	<e:Rect id="bgClose" fillAlpha="0.7" left="0" top="0" right="0" bottom="0"/>
	<e:Group id="anigroup" horizontalCenter="0" width="578" anchorOffsetY="0" height="735" verticalCenter="0">
		<e:Image source="bantoutiaobg" height="30" horizontalCenter="0" bottom="0" width="300"/>
