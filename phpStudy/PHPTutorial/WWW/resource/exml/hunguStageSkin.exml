		<e:Image source="tongyong_juanzhou" scale9Grid="209,0,69,0" left="0" right="0" top="0"/>
		<e:Image top="-15" source="tongyong_titlebg" horizontalCenter="0"/>
		<e:Image id="zuoBG" source="hunguuplevelbg_png" top="70" left="61"/>
		<e:Image id="youBG" source="hunguuplevelbg_png" top="70" right="65"/>


		<e:Label text="龙元升阶" size="22" horizontalCenter="0" top="-3" fontFamily="Microsoft YaHei" textColor="0x084151"/>




