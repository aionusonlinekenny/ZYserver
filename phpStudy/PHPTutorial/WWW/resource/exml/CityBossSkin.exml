<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="SkinCityBoss" xmlns:e="http://ns.egret.com/eui" xmlns:ns1="*" xmlns:w="http://ns.egret.com/wing" height="794" width="600">

	<e:Group width="600" height="794" verticalCenter="0" horizontalCenter="0">
		<e:Image source="worldbossbg_png" width="408" height="304" horizontalCenter="-66" top="165"/>
		<e:Image width="432" height="163" horizontalCenter="-66" source="worldbossbg2_png" top="406"/>
		<e:Group id="bossGroup" width="200" height="200" horizontalCenter="-50" verticalCenter="21"/>
		<e:Image width="157" right="2" top="95" bottom="18" source="tongyong_dikuang4" scale9Grid="13,11,56,60"/>
		<e:Scroller top="100" bottom="26" width="161" right="1" height="608">
			<e:List id="list" useVirtualLayout="false" itemRendererSkinName="SkinCityBossItem">
			<e:layout>
				<e:VerticalLayout gap="2"/>
			</e:layout>
			</e:List>
		</e:Scroller>
		<e:Button id="challengeBtn" label="Thách đấu" skinName="SkinBtn1" horizontalCenter="-58" top="726" height="69"/>
		<e:Image id="redPoint" touchEnabled="false" source="zjmhongdian" horizontalCenter="17.5" top="727"/>
		<e:Image horizontalCenter="-65" width="284" top="22" source="huabian" height="48" scale9Grid="0,0,214,50"/>
		<e:Label id="nameTxt" text="BOSS名字70级" horizontalCenter="-65" size="22" top="44" fontFamily="Microsoft YaHei"/>
		<e:Label id="canChallengeTxt" text="80级可挑战" horizontalCenter="-52.5" size="26" fontFamily="Microsoft YaHei" top="750" height="24" textColor="0x00842c"/>

		<e:Image width="440" horizontalCenter="-80" anchorOffsetY="0" anchorOffsetX="0" source="longhuntextbg2" top="591" height="113.7" scale9Grid="0,13,591,12"/>

		<e:Label id="leftText" text="Tổng số lần thách đấu còn lại：1 lần" size="18" horizontalCenter="-57.5" bottom="71" fontFamily="Microsoft YaHei" visible="false"/>
		<e:Image id="stateImage" top="346" horizontalCenter="-2" source="zdbosskejisha_png" visible="false"/>
		<e:Group horizontalCenter="-81" top="78" x="63" y="115">
			<e:Label text="击杀" size="18" horizontalCenter="-81.5" top="140" x="-170" fontFamily="Microsoft YaHei" textColor="0xffff00"/>
			<e:Label id="bossName" text="猪妖王" size="18" horizontalCenter="-81.5" top="140" x="-160" y="10" textColor="0x00ff00" fontFamily="Microsoft YaHei"/>
			<e:Label text="达到目标数量可在主城刷新" size="18" horizontalCenter="-81.5" top="140" x="-150" y="20" fontFamily="Microsoft YaHei" textColor="0xffff00"/>
			<e:layout>
			<e:HorizontalLayout gap="3"/>
			</e:layout>
		</e:Group>
		<e:Group width="252" height="22" top="106" horizontalCenter="-82" x="98" y="140">
			<e:Image width="252" scale9Grid="27,0,2,23" horizontalCenter="-1" verticalCenter="0" source="sliderbg1"/>
			<e:ProgressBar id="killProgressBar" width="211" skinName="Skinbar5" value="0" horizontalCenter="-0.5" x="1" verticalCenter="-0.25"/>
		</e:Group>
		<e:Image top="12" source="yuangu_xianshihuodong_png" y="10" horizontalCenter="-74.5"/>
		<e:Label id="nextTime" text="最快将于2018年12月12日（周二） 12:12刷新" size="18" textColor="0x00ff00" horizontalCenter="-81.5" top="138" fontFamily="Microsoft YaHei" x="33" y="166"/>

		<e:Image  y="567" horizontalCenter="-69" source="yuangu_diaoluo_png"/>
		<e:Scroller width="340" horizontalCenter="-69" top="605" height="107">
		<e:List id="rewardList" itemRendererSkinName="SkinItem2">
			<e:layout>
			<e:HorizontalLayout horizontalAlign="center" gap="40"/>
			</e:layout>
		</e:List>
		</e:Scroller>
	</e:Group>



































</e:Skin>