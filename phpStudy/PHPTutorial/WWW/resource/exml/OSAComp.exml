<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="OSAComp" width="563" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing" xmlns:ns1="*"  height="681">
	<e:Group left="0" right="0" top="0" bottom="0">
