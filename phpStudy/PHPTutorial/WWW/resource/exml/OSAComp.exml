		<e:Label text="无兄弟，不传奇！" x="50" size="20" fontFamily="Microsoft YaHei" textColor="0xffffff" top="360" visible="false"/>
		<e:Label text="拿下仙宫人人有份，可别忘了犒劳盟中道友!" size="18" fontFamily="Microsoft YaHei" textColor="0xffffff" top="425" horizontalCenter="0" visible="false"/>
		<e:Label text="给兄弟发红包哦！" size="18" fontFamily="Microsoft YaHei" textColor="0xffffff" top="410" horizontalCenter="140.5" visible="false"/>
