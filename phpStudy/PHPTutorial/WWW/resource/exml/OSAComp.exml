		</e:Group>

		<e:Group id="reward" horizontalCenter="0" top="438">
			<ns1:ItemBase id="reward1" x="100" y="2" skinName="SkinItem2"/>
			<ns1:ItemBase id="reward2" x="110" y="12" skinName="SkinItem2"/>
