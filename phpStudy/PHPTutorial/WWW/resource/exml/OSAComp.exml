		<e:Group id="infoBg" horizontalCenter="0.5" width="540" top="46">

			<e:Label text="活动时间：" x="3" y="12" size="20" textColor="0xffffff" fontFamily="Microsoft YaHei"/>
			<e:Label id="actTime" text="7月30日20:00-20:20(周日)" x="104" y="12" size="20" fontFamily="Microsoft YaHei" textColor="0x00ff06"/>
			<e:Label id="actInfo" text="活动期间首个带领仙盟攻占仙宫的仙盟盟主可获得丰厚奖励，奖励通过邮件发放" x="104" y="32" size="20" width="344" bottom="2" top="42" left="104" right="14" textColor="0xffffff" fontFamily="Microsoft YaHei"/>
