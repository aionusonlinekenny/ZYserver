		<e:Group y="0" horizontalCenter="0">
			<e:Image id="title" y="0" horizontalCenter="28" source="labwin_png"/>
		</e:Group>
		<e:Group id="effGroup" touchChildren="false" touchEnabled="false" y="198" horizontalCenter="-12" x="230"  />
		<e:Button id="closeBtn" label="退出(10s)" skinName="SkinBtn1" horizontalCenter="-154" y="812"/>
		<e:Button id="challengeBtn" label="继续挑战" skinName="SkinBtn1" horizontalCenter="154" y="812"/>
		<e:Label id="assResultTxt" text="等待队长操作（10s）" y="834" size="20" horizontalCenter="0.5" fontFamily="Microsoft YaHei" textColor="0xffff00"/>
