			<e:Image width="544" horizontalCenter="0" source="bantoutiaobg" scale9Grid="161,10,61,13" x="18" top="8" bottom="2.3"/>
			<e:Image horizontalCenter="0" source="fuentitlebg3" scale9Grid="267,0,2,1" x="0" bottom="3.5"/>
			<e:Group id="biankuangTop0" width="580" height="16" horizontalCenter="0" anchorOffsetY="0" top="0">
			<e:Image y="8" horizontalCenter="0" source="fuentitlebg3" scale9Grid="267,0,2,1" x="0"/>
			<e:Image y="-2" horizontalCenter="0" source="fuentitlebg" x="250"/>
			</e:Group>
		</e:Group>
		<e:Group width="600" height="483" id="defeat" y="272" horizontalCenter="0" anchorOffsetY="0">
			<e:Image horizontalCenter="0" source="huabian" y="-19"/>
			<e:Label id="lostTxt" text="Tôi muốn mạnh hơn"  size="22" y="7" horizontalCenter="0" fontFamily="Microsoft YaHei" textColor="0xabebff"/>
			<e:Image id="openRole" scaleX="0.9" scaleY="0.9"  width="478" source=""  height="34" horizontalCenter="0" verticalCenter="205"/>
			<e:Button id="openRole1" label="前往" y="450.62"  skinName="SkinBtn3" horizontalCenter="0" visible="false"/>
			<e:Scroller width="372" height="438" verticalCenter="22.5" horizontalCenter="0" anchorOffsetY="0">
			<e:List id="list0" y="0" itemRendererSkinName="SkinDefeatItem"   horizontalCenter="0" anchorOffsetY="0" height="438">
				<e:layout>
				<e:TileLayout horizontalGap="0" verticalGap="5"/>
				</e:layout>
			</e:List>
			</e:Scroller>
		</e:Group>
		<e:Group id="win" y="292" horizontalCenter="0" width="528">
			<e:Label text="挑战者" size="20" y="8" horizontalCenter="0" fontFamily="Microsoft YaHei" textColor="0xffffff"/>
			<e:List id="listChallenger" y="36" itemRendererSkinName="SkinChallengerHead" horizontalCenter="0">
				<e:layout>
				<e:HorizontalLayout gap="10"/>
				</e:layout>
			</e:List>
			<e:Label text="获得道具" y="143" size="20" verticalAlign="middle" horizontalCenter="0" fontFamily="Microsoft YaHei" textColor="0xffffff"/>
			<e:List id="listItem" y="172" scaleX="1" scaleY="1" anchorOffsetY="0" horizontalCenter="0" itemRendererSkinName="SkinItem2">
				<e:layout>
				<e:TileLayout horizontalGap="10" verticalGap="2" requestedRowCount="1" requestedColumnCount="6"/>
				</e:layout>
			</e:List>
			<e:Label text="协助者：" size="20" x="0" y="334" fontFamily="Microsoft YaHei" textColor="0xffffff"/>
			<e:List id="listAssistant" y="290" itemRendererSkinName="SkinAssistantHead" x="76">		
