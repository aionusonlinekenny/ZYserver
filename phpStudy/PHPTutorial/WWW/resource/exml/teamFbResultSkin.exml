        height="948" width="600">
	<w:Config id="15c8d32c190" />
	<e:Rect fillAlpha="0.6" left="0" right="0" top="0" bottom="0" />
	<e:Group horizontalCenter="0" width="600" y="0" height="948">
		<e:Image source="tongyong_bgsuc" width="600" horizontalCenter="0" top="0" bottom="0"/>
