<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="SkinBoss" width="600" height="948" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing"
        xmlns:ns1="*" xmlns:euiextension="euiextension.*">

	<e:Rect width="600" fillColor="0x0d97ae" horizontalCenter="0" top="0" bottom="0"/>
    <e:Image horizontalCenter="0" source="bg_1_jpg" verticalCenter="-35"/>
	<e:Image source="chuangtianguanbg_png" width="600" horizontalCenter="0" verticalCenter="-117"/>



	<ns1:RoleSelectPanel id="roleSelect" skinName="SkinRoleSelectPanel"  width="600" horizontalCenter="0" currentState="nohead"/>
	<e:Image id="title"  horizontalCenter="-203.5" top="13" source="biaoti_boss_png"/>
	<e:ViewStack id="viewStack" selectedIndex="2" width="600" horizontalCenter="0" height="728" verticalCenter="-57">
		<ns1:PersonalBossPanel id="personalBoss" skinName="SkinPersonalBossPanel" name="个人BOSS" top="0" bottom="0" left="0" right="0"/>
		<ns1:PublicBossesPanel id="publicBoss" skinName="SkinPublicBossPanel" name="野外BOSS" left="0" right="0" top="0" bottom="0" visible="false"/>
