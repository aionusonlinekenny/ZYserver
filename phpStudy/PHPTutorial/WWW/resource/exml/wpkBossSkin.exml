<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="SkinWpkBoss" xmlns:e="http://ns.egret.com/eui"
        xmlns:w="http://ns.egret.com/wing" xmlns:euiextension="euiextension.*" xmlns:ns1="*" width="600" height="948">
	<e:Rect id="bgClose" left="0" right="0" top="0" bottom="0" fillAlpha="0.6"/>
	<e:Group width="570" height="690" horizontalCenter="0" verticalCenter="-40">

		<e:Group horizontalCenter="0" bottom="-47">
			<e:Image source="bantoutiaobg" height="35" width="400" y="0" scale9Grid="180,8,15,23"/>
			<e:Label text="Chạm vùng trống để đóng cửa sổ" size="18" horizontalCenter="0" verticalCenter="-2" fontFamily="Microsoft YaHei" textColor="0xffffff"/>
		</e:Group>
		<e:Image left="0" right="0" bottom="0" source="tongyong_dikuang2" scale9Grid="30,4,63,55" height="664" anchorOffsetY="0"/>
		<e:Image y="16" source="tongyong_juanzhou" left="0" right="0"/>
		<e:Image y="53" horizontalCenter="0" scaleY="1" source="bossbg_jpg"/>
		<e:Image y="0" source="tongyong_titlebg" horizontalCenter="0"/>
		<e:Label text="世界BOSS" size="22" y="14" horizontalCenter="0" fontFamily="Microsoft YaHei" textColor="0x084151"/>

		<e:Button id="closeBtn0" label="Nút bấm" skinName="SkinBtn0" right="0" y="3" icon="tongyong_btnclose"/>
		<e:Image id="help" x="496" y="60" source="wenhao"/>
		<e:Group id="boss" y="168" horizontalCenter="0" touchEnabled="false" touchChildren="false">
			<e:Image id="bossImg" source=""/>
		</e:Group>
		<e:Group id="blood" y="466" horizontalCenter="0" width="300" height="20">

			<e:Image id="barBg" y="0" source="jingyantiao6" left="5" right="5" height="18" alpha="0.9" scale9Grid="4,3,19,8"/>
			<e:ProgressBar id="bar" value="10" height="15" skinName="Skinbar3" y="1" left="6" right="6"/>
			<e:Label id="bossBloodPercentageLabel" text="100%" y="0.01" fontFamily="Microsoft YaHei" size="16" x="138"/>
			<e:Image width="20" height="20" x="-9" y="-1" source="jindutiaotou"/>
			<e:Image width="20" height="20" x="308" y="18" source="jindutiaotou" rotation="180"/>

		</e:Group>
		<e:List id="list" itemRendererSkinName="SkinItem" horizontalCenter="0" bottom="122">
			<e:layout>
			<e:HorizontalLayout horizontalAlign="center" gap="8"/>
			</e:layout>
		</e:List>
		<e:Button id="enter" label="Vào chiến trường" horizontalCenter="0" bottom="64" skinName="SkinBtn26" icon="chat_btnbg" scaleX="1.1" scaleY="1.1"/>
		<e:Label text="每日19点30分开启" horizontalCenter="0" size="20" bottom="28" fontFamily="Microsoft YaHei" textColor="0x00ff00"/>
		<e:Label id="nameTxt" text="BOSS名字" horizontalCenter="0" size="24" y="70" fontFamily="Microsoft YaHei" textColor="0xffff00" stroke="1"/>
		<e:Group id="tips" horizontalCenter="0" y="53" visible="false">
			<e:Label text="你可以进入" size="18" x="50" y="0" fontFamily="Microsoft YaHei" textColor="0xffff00"/>
			<e:Label id="level0" text="初级战场" size="18" x="59" y="0" fontFamily="Microsoft YaHei" textColor="0xec6014"/>
			<e:Label id="level1" text="(3转可进入中级战场)" size="18" x="0" y="0" fontFamily="Microsoft YaHei" textColor="0xffff00"/>
			<e:layout>
				<e:HorizontalLayout gap="2"/>
			</e:layout>
		</e:Group>

	</e:Group>

</e:Skin>