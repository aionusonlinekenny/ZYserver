<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="SkinTuJianSuitTips" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing"
        xmlns:euiextension="euiextension.*" xmlns:ns1="*">
	<w:Config id="1586b3502a7" />
	<e:Rect id="bgClose" fillAlpha="0.8" left="0" right="0" top="0" bottom="0" />
	<e:Group id="anigroup" horizontalCenter="0" verticalCenter="0">
		<e:Image id="qualityImg" left="3" right="3"  source="tongyongtip1" scale9Grid="17,7,36,47" top="3" bottom="3"/>
		<e:Image source="tongyongtip2" left="0" right="0" top="0"  bottom="0" scale9Grid="18,18,43,26"/>
		<e:Label id="nameLabel" text="Cộng thêm Bộ Con Đường Huyền Thoại" size="30"  horizontalCenter="0" y="25" fontFamily="Microsoft YaHei" textColor="0xfffc00"/>
		<e:List id="suitlist" width="385" itemRendererSkinName="SkinTuJianSuitItem" horizontalCenter="0" y="96">
			<e:layout>
			<e:VerticalLayout gap="5" paddingBottom="50" paddingTop="10"/>
			</e:layout>
		</e:List>
		<e:Group bottom="-36" horizontalCenter="0">
			<e:Image source="bantoutiaobg" height="35" scale9Grid="128,2,15,41" width="300" touchEnabled="false" y="0" horizontalCenter="0"/>
			<e:Label text="Chạm vùng trống để đóng cửa sổ" size="20" touchEnabled="false" y="6" fontFamily="Microsoft YaHei" textColor="0xffffff" horizontalCenter="0"/>
		</e:Group>
		<!--<e:Group id="powerGroup" x="32" y="143"  height="41" locked="true">
		<e:Image source="zjmzhandouli" />
	</e:Group>
	-->
</e:Group>
</e:Skin>