		<e:Image id="imgIcon" verticalCenter="-97" horizontalCenter="-132" width="62" height="62" source="luckyBossBtn"/>
		<e:Label id="itemName" text="购买幸运Boss次数" y="41" size="20" x="146" fontFamily="Microsoft YaHei" textColor="0xffff00"/>
