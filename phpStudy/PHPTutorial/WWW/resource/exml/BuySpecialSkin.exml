	<w:Config id="1586bde6cc9"/>
	<e:Rect id="bgClose" left="0" right="0" top="0" bottom="0" fillAlpha="0.8"/>
	<e:Group width="400" height="320" horizontalCenter="0" verticalCenter="0">
		<e:Image source="bantoutiaobg" height="35" horizontalCenter="0" bottom="-45" width="300" touchEnabled="false" scale9Grid="186,2,15,28"/>
