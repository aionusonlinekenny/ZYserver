		<e:Image left="0" right="0" top="0" bottom="0" scale9Grid="12,9,7,10" source="tongyongtip1"/>
		<e:Image source="tongyongtip2" left="-1" right="-1" top="-1" bottom="-1" scale9Grid="18,18,2,4"/>
		<e:Image id="imgBg" source="quality0" scale9Grid="9,9,46,46" width="76" height="76" verticalCenter="-97" horizontalCenter="-132"/>
