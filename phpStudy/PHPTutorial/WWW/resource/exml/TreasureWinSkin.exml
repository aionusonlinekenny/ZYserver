<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="SkinTreasureWin" width="600" height="948" xmlns:e="http://ns.egret.com/eui"
        xmlns:w="http://ns.egret.com/wing" xmlns:ns1="*">
    <e:Rect width="600" fillColor="0x0d97ae" horizontalCenter="0" top="0" bottom="0"/>
  	<e:Image horizontalCenter="0" source="bg_1_jpg" verticalCenter="-35"/>
    <e:ViewStack id="viewStack" width="600" selectedIndex="2" horizontalCenter="0" top="0" bottom="0">
        <ns1:LongHunWindow id="ShenluPanel" name="御器" skinName="SkinShenluNew" width="600" horizontalCenter="0" height="728" verticalCenter="-57" visible="false"/>
		<ns1:JadeNewPanelView id="YupeiPanel" name="炼阵" skinName="SkinYuPeiNew" horizontalCenter="0" verticalCenter="-57" height="728" visible="false"/>
			<ns1:HeartMethodWindow id="HeartPanel" name="道藏"  horizontalCenter="0" width="600" height="728" verticalCenter="-57" skinName="Skinheartmethod"/>
		<ns1:ShenshouView id="shenshouPanel" name="万兽驭使" skinName="Skinshenshou" anchorOffsetY="0" horizontalCenter="0" height="728" verticalCenter="-57" visible="false"/>
			<ns1:HunguWindow id="HunguPanel" name="龙元" skinName="Skinhungu" anchorOffsetY="0" top="0" bottom="0" left="0" right="0" visible="false"/>
    </e:ViewStack>
	<e:Image width="592" anchorOffsetX="0" anchorOffsetY="0" source="bantoumingkuang3" horizontalCenter="0" bottom="98"/>
   <e:TabBar id="tab" itemRendererSkinName="SkinBtnTab0" dataProvider="{viewStack}" selectedIndex="0"
              horizontalCenter="0" bottom="106">
        <e:layout>
            <e:HorizontalLayout gap="-8" />
        </e:layout>
    </e:TabBar>
	<ns1:RoleSelectPanel id="roleSelect" skinName="SkinRoleSelectPanel" width="600" horizontalCenter="0" top="0" locked="true"/>
	<e:Button id="help" label="Nút bấm" skinName="SkinBtn0" icon="wenhao" horizontalCenter="-276" y="4" scaleX="0.9" scaleY="0.9" visible="false"/>
	<e:Group id="redPointGroup" bottom="143" horizontalCenter="50.5" touchEnabled="false">
		<e:Image id="redPoint0" touchEnabled="false" source="zjmhongdian" x="120" y="0"/>
		<e:Image id="redPoint1" touchEnabled="false" source="zjmhongdian" x="0" y="0"/>
		<e:Image id="redPoint2" touchEnabled="false" source="zjmhongdian" x="0" y="0"/>
		<e:Image id="redPoint3" touchEnabled="false" source="zjmhongdian" x="0" y="0"/>
		<e:Image id="redPoint4" touchEnabled="false" source="zjmhongdian" x="0" y="0"/>
		<e:layout>
			<e:HorizontalLayout gap="94"/>
		</e:layout>
	</e:Group>
	<e:Image id="title" horizontalCenter="-222" source="biaoti_longhun" top="8"/>
	<e:Button id="closeBtn" label="Nút bấm" skinName="SkinBtn0" icon="chatclose" top="44" horizontalCenter="273" right="0"/>
</e:Skin>