			<e:HorizontalLayout gap="0"/>
			</e:layout>
		</e:Group>
		<ns1:ItemIcon id="itemIcon" skinName="SkinItemIcon" x="20" y="52"/>
		<e:Label id="nameLabel" text="Ôn Dưỡng Đan Sơ Cấp" size="20" textAlign="left" y="20" x="20" textColor="0xff9900" fontFamily="Microsoft YaHei"/>
