		<e:Label id="attr" text="Công kích+100\nSát thương Bạo kích cộng thêm+10100\nSát thương Bạo kích cộng thêm+1000\nSát thương Bạo kích cộng thêm+1000" size="18" width="320" textAlign="left" x="15" lineSpacing="7" top="185" bottom="45" fontFamily="Microsoft YaHei" textColor="0x00ff00"/>
		<e:Group x="15" bottom="15">
			<e:Label text="Có thể ở" size="18" y="0" textAlign="left" x="81" fontFamily="Microsoft YaHei" textColor="0x6b9baa"/>
