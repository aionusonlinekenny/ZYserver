		<e:Label text="Đang sử dụng：" size="20" x="120" y="66" fontFamily="Microsoft YaHei" textColor="0x6b9baa"/>
		<e:Label id="use" text="10/100" size="20" x="220" y="66" fontFamily="Microsoft YaHei" textColor="0xffffff"/>
		<e:Group id="info" y="130" left="13">
			<e:Label text="（Pháp Trận đạt" size="16" x="0" y="0" textColor="0xFF0000" fontFamily="Microsoft YaHei"/>
			<e:Label id="num0" text="Bậc 30 cấp 10" size="16" x="60" y="0" fontFamily="Microsoft YaHei" textColor="0x00ff00"/>
			<e:Label text="sau đó tăng giới hạn sử dụng）" size="16" x="10" y="10" textColor="0xFF0000" fontFamily="Microsoft YaHei"/>
			<e:layout>
			<e:HorizontalLayout gap="0"/>
