<?xml version="1.0" encoding="utf-8" ?>
<e:Skin class="SkinTitleItem" states="simple,expand" width="578" height.simple="107" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing" height="438">
	<w:Config id="16629d21740"/>
	<e:Image id="titleBg" width="568" horizontalCenter="0" includeIn="expand" source="tongyong_dikuang7" scale9Grid="10,10,48,32" top="110" bottom="0"/>
	<e:Image anchorOffsetY="0" width="578" height="108" top="2" horizontalCenter="0" alpha="1" source="tongyonglabbg2" scale9Grid="70,20,10,36"/>
    <e:Image id="img" source="ch_2_png" y.simple="10" left="16" anchorOffsetX="0" width="225" anchorOffsetY="0" height="76" top="12"/>
	<e:Button id="btnSet" label="Mặc/Đeo" icon="xch_02" width="125" horizontalCenter="87.5" height="53" top="30" skinName="SkinBtn3"/>
	<e:Label id="labLack" text="Chưa nhận" size="24" x.simple="340" y.simple="32" y.expand="32" x.expand="340" fontFamily="Microsoft YaHei" horizontalCenter="88" top="43" textColor="0x1b3046"/>
	<e:Label id="time" text="Thời hạn：" size="18" textAlign="left" y="65" x="316" fontFamily="Microsoft YaHei" anchorOffsetY="0" height="19" top="82" width="145" horizontalCenter="103.5" textColor="0x00ff00"/>
	<e:Image rotation="0" source.expand="btnmax" rotation.expand="180" y.expand="21" x.expand="516" horizontalCenter="234.5" top="21" source="btnmax"/>
	<e:Group width="546" anchorOffsetX="0" horizontalCenter="0" verticalCenter="46" anchorOffsetY="0" height="346.33" includeIn="expand">
		<e:Group width="100%" height="93">
			<e:Image y="-4" width="255" horizontalCenter="0.5" anchorOffsetY="0" height="46" source="huabian" scale9Grid="87,0,29,48"/>
			<e:Label text="Thuộc tính danh hiệu hiện tại" y="16" size="21" horizontalCenter="0" fontFamily="Microsoft YaHei" textColor="0xffffff" textAlign="center"/>
			<e:Group id="power" y="55" x="293"/>
			<e:Label id="labRare" text="Độ hiếm：" size="20" width="123" textAlign="left" fontFamily="Microsoft YaHei" textColor="0x1b3046" top="56" x="416"/>
			<e:Image x="18" y="40" source="zhandoulibg" visible="false"/>
			<e:Image source="wingzhanli" y="55" x="184"/>
		</e:Group>

		<e:DataGroup id="attrs" dataProvider="{data.attrsText}" width="320">
			<e:itemRendererSkinName>
			<e:Skin>
				<e:Label size="20" textColor="0x1b3046" fontFamily="Microsoft YaHei">
				<e:textFlow>
					<e:Object text="{data.h}"/>
					<e:Object text="{data.t}" style="{data}"/>
				</e:textFlow>
				</e:Label>
			</e:Skin>
			</e:itemRendererSkinName>
			<e:layout>
				<e:TileLayout horizontalGap="125" verticalGap="2" rowHeight="25" columnWidth="100" requestedRowCount="2" requestedColumnCount="2" horizontalAlign="left" verticalAlign="middle"/>
			</e:layout>
		</e:DataGroup>
		<e:Label id="conditionTxt" size="20" width="430" text="Điều kiện nhận：" textAlign="center" fontFamily="Microsoft YaHei" textColor="0xffff00" x="110"/>
		<e:Group width="100%" y="258" anchorOffsetX="0">
			<e:Image y="-12" width="255" height="46" horizontalCenter="0" scale9Grid="28,0,67,18" source="huabian"/>
			<e:Label text="Tổng thuộc tính danh hiệu" y="7" size="21" horizontalCenter="0" fontFamily="Microsoft YaHei" textColor="0xffffff" textAlign="center"/>
		</e:Group>
		<e:DataGroup id="attrsTotal" dataProvider="{data.attrsTotal}" width="320">
			<e:itemRendererSkinName>
				<e:Skin>
					<e:Label size="20" textColor="0x1b3046" fontFamily="Microsoft YaHei">
						<e:textFlow>
							<e:Object text="{data.h}"/>
							<e:Object text="{data.t}" style="{data}"/>
						</e:textFlow>
					</e:Label>
				</e:Skin>
			</e:itemRendererSkinName>
			<e:layout>
				<e:TileLayout columnWidth="100" verticalGap="2" paddingTop="0" rowHeight="25" requestedColumnCount="2" horizontalGap="125" requestedRowCount="2" horizontalAlign="left" verticalAlign="middle"/>
			</e:layout>
		</e:DataGroup>
		<e:Label text="Thuộc tính danh hiệu sẽ cộng dồn cho tất cả nhân vật của người chơi" y="259" size="20" textAlign="center" width="430" fontFamily="Microsoft YaHei" textColor="0xffff00"/>
		<e:layout>
			<e:VerticalLayout gap="7" horizontalAlign="center" paddingBottom="0" verticalAlign="middle"/>
		</e:layout>
	</e:Group>
	<e:Image id="ti" anchorOffsetY="0" alpha="0.5" source="name_bmp" anchorOffsetX="0" y="-9" x="-3" height="394" width="592" locked="true" visible="false"/>
</e:Skin>
