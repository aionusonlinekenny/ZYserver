<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="SkinGuildNameChange" width="480" height="800" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing" xmlns:ns1="*">
	<e:Rect id="bgClose" left="0" right="0" top="0" bottom="0" fillAlpha="0.6"/>	
	<e:Group id="anigroup" height="300" width="350" verticalCenter="0" horizontalCenter="0">
		<e:Image scale9Grid="8,3,27,39" left="0" right="0" top="2" bottom="0" source="tongyongtip1"/>
		<e:Image left="2" right="2" source="tongyongtip2" scale9Grid="21,13,31,34" bottom="2" top="2"/>
		<e:Label y="12" text="Đổi tên Tiên Minh" size="24" horizontalCenter="0" textColor="0xbd600d" fontFamily="Microsoft YaHei"/>
		<e:Label id="txt" y="100" text="Do gộp server trùng tên, có thể đổi tên miễn phí một lần." size="20" horizontalCenter="0" textAlign="center" fontFamily="Microsoft YaHei" textColor="0xffff00"/>
		<e:Button id="closeBtn" label="Nút bấm" skinName="SkinBtn0" right="4" bottom="-66" visible="false"/>
		<e:Button id="sureBtn" skinName="SkinBtn1" label="Xác nhận thay đổi" horizontalCenter="0" bottom="30"/>
		<e:Image y="136" scale9Grid="6,6,3,3" width="250" height="40" source="shuzibg" horizontalCenter="0"/>
		<e:EditableText id="input" width="230" prompt="单击此处输入名字" maxChars="20" size="20" promptColor="0xffffff" multiline="false" textAlign="center" verticalAlign="middle" horizontalCenter="0" y="140" fontFamily="Microsoft YaHei"/>
	</e:Group>
</e:Skin>