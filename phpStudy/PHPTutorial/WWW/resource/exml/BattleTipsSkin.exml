<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="SkinBattleTips" width="480" height="728" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing"
        xmlns:ns1="*" xmlns:euiextension="euiextension.*">
	<e:Rect id="bgClose" left="0" right="0" top="0" bottom="0" fillAlpha="0.6"/>









	<e:Group id="anigroup" horizontalCenter="0" verticalCenter="0" width="465" height="635">
		<e:Image scale9Grid="25,18,2,2" left="0" right="0" top="0" bottom="0" source="tongyong_dikuang2"/>
		<e:Image top="0" scale9Grid="198,5,14,37" left="0" right="0" source="tongyong_juanzhou"/>
		<e:Image source="tongyong_titlebg" width="249" y="-18" horizontalCenter="0"/>
		<e:Image width="401" horizontalCenter="0" source="tongyong_dikuang4" height="490" scale9Grid="10,10,60,60" bottom="100"/>
		<e:Label text="万仙杀劫" horizontalCenter="0" top="-6" size="24" fontFamily="Microsoft YaHei" textColor="0x084151"/>
		<e:Group x="44" y="51">

			<e:Label text="活动描述：" size="20" horizontalCenter="0" fontFamily="Microsoft YaHei" textColor="0xffff00"/>
		</e:Group>

		<e:Label id="desc" text="       夜晚的比奇迷人又充满了神秘的气息。在夜黑风高的时候进去一探究竟吧，你一定会大呼过瘾的。" y="86" size="20" width="380" lineSpacing="10" textAlign="left" fontFamily="Microsoft YaHei" textColor="0x001828" x="44"/>
		<e:Group x="44" y="181">

			<e:Label text="活动规则：" size="20" fontFamily="Microsoft YaHei" textColor="0xffff00"/>
		</e:Group>

		<e:Label id="rule" text="1.活动时间：|C:0x00ff00&amp;T:每周一、三、五 20:30-20:45|\n2.参与活动即可获得|C:0x00ff00&amp;T:功勋|奖励\n3.进入活动后玩家随机分配成|C:0x00ff00&amp;T:2个对立阵营|，每|C：0x00ff00&amp;T:5分钟|重新分配阵营\n4.击败玩家、助攻、杀怪、持续参与活动都可以获得积分，个人积分越高，奖励越丰厚\n5.活动结束后根据玩家综合表现发放排名奖励\n|C:0x5186fd&amp;T:PS：血战比奇城待得越久，获得的功勋越多|" size="20" width="380" lineSpacing="10" top="209" bottom="109" fontFamily="Microsoft YaHei" textColor="0x001828" x="44"/>






		<e:Button id="goTo" label="进入" skinName="SkinBtn1" bottom="15" horizontalCenter="0"/>
		<e:Button id="closeBtn" label="进入" skinName="SkinBtn0" horizontalCenter="213" top="-17" icon="tongyong_btnclose"/>
		<e:Image id="redPoint" touchEnabled="false" source="zjmhongdian" bottom="65" horizontalCenter="78" visible="false"/>
		<e:Image width="300" horizontalCenter="0" height="34" scale9Grid="10,10,60,60" bottom="-44" source="bantoutiaobg"/>
		<e:Label text="点击空白区域关闭窗口" size="20" width="200" lineSpacing="10" fontFamily="Microsoft YaHei" horizontalCenter="0" bottom="-36" height="20"/>
	</e:Group>




</e:Skin>