<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="SkinTeamFbFight" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing" xmlns:ns1="*" width="600"
        height="948">
	<e:Group id="teamFbMember" width="106" height="234" right="0" anchorOffsetY="0" verticalCenter="-97">
		<e:Image width="110" height="28" horizontalCenter="0" source="gwdi_2_png" scale9Grid="3,4,58,11"/>
		<e:Image width="110" height="205" horizontalCenter="0" scale9Grid="3,4,58,11" top="29" source="zsbg2"/>
		<e:Label text="队伍成员" size="16" y="6" horizontalCenter="0" fontFamily="Microsoft YaHei" textColor="0xffffff" stroke="0"/>
		<ns1:TeamFbMembersItemRender id="member1" y="33" horizontalCenter="0" skinName="SkinTeamFbMember"/>
		<ns1:TeamFbMembersItemRender id="member2" y="134" horizontalCenter="0" skinName="SkinTeamFbMember"/>
	</e:Group>
	<e:Image width="499" height="150" horizontalCenter="0" bottom="142" source="zsbg2" scale9Grid="4,5,86,13"/>
	<e:Group id="teamFbTarget" anchorOffsetY="0" horizontalCenter="0" bottom="138">
		<ns1:TeamFbMonsterItemRender id="target1" y="33" horizontalCenter="0" scaleX="0.8" scaleY="0.8" skinName="SkinTeamFbTarget"/>
		<ns1:TeamFbMonsterItemRender id="target2" y="134" horizontalCenter="0" scaleX="0.8" scaleY="0.8" skinName="SkinTeamFbTarget"/>
		<ns1:TeamFbMonsterItemRender id="boss" y="134" horizontalCenter="0" skinName="SkinTeamFbTarget"/>
		<ns1:TeamFbMonsterItemRender id="target3" y="134" horizontalCenter="0" scaleX="0.8" scaleY="0.8" skinName="SkinTeamFbTarget"/>
		<ns1:TeamFbMonsterItemRender id="target4" y="134" horizontalCenter="0" scaleX="0.8" scaleY="0.8" skinName="SkinTeamFbTarget"/>
		<e:layout>
			<e:HorizontalLayout verticalAlign="middle" gap="4" horizontalAlign="center"/>
		</e:layout>
	</e:Group>
	<e:Group id="teamFbTime" anchorOffsetY="0" height="140" anchorOffsetX="0" width="220" right="0" top="0">
		<e:Image anchorOffsetX="0" anchorOffsetY="0" rotation="0" height="140" y="0" scale9Grid="1,4,217,12" source="fuben_bg1_png" width="280" right="0"/>
		<e:Label id="leftTimeTxt" size="20" horizontalCenter="0" y="78" fontFamily="Microsoft YaHei" textColor="0xffff00" stroke="0.6"/>
		<e:Label text="剩余活动时间 :" size="20" horizontalCenter="0" fontFamily="Microsoft YaHei" textColor="0xffff00" y="50" stroke="0.6"/>
		<e:Label id="gonglveTxt" text="Xem hướng dẫn" size="20" touchEnabled="true" fontFamily="Microsoft YaHei" textColor="0x00ff06" y="111" horizontalCenter="0"/>
		<e:Image id="teamFbName" source="tfb_title1" horizontalCenter="3" x="9" y="3"/>
	</e:Group>



</e:Skin>