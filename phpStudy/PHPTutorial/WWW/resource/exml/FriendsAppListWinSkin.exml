<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="SkinFriendsAppListWin" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing" xmlns:ns1="*" width="600" height="348">
	<e:Group top="0" left="0" right="0" bottom="0">
		<e:Image width="1" height="422" source="chat_line_png" rotation="90" horizontalCenter="-16" bottom="32"/>
		<e:Group id="group_shenqing" horizontalCenter="-12" verticalCenter="-20" visible="false">
			<e:Label text="暂时没有任何申请" size="20" fontFamily="Microsoft YaHei" textColor="0xffff00"/>
		</e:Group>
		<e:Group width="542" height="303" horizontalCenter="-19" top="8">
			<e:Scroller width="542" anchorOffsetY="0" height="303" horizontalCenter="0" top="0">
				<e:List id="list_appList" itemRendererSkinName="SkinFriendsAppListItem" width="542" height="303">
					<e:layout>
						<e:VerticalLayout gap="2"/>
					</e:layout>
				</e:List>
			</e:Scroller>
			<e:Button id="btn_allYes" label="一键同意" skinName="SkinBtn1" visible="false"/>
<e:Button id="btn_allNo" label="一键拒绝" skinName="SkinBtn1" visible="false"/>
		</e:Group>
		<e:Label text="GM不会以任何形式询问玩家帐号和密码，或私聊发布中奖信息。" size="18"   textColor="0xffff00" fontFamily="Microsoft YaHei" horizontalCenter="24.5" bottom="8"/>
		<e:Image   source="gantanhao4" width="18" height="24" horizontalCenter="-251" bottom="6"/>
		<e:Button id="btnFind" label="Button" skinName="SkinBtn0" icon="chatfind" horizontalCenter="276.5" verticalCenter="-6.5"/>
	</e:Group>
</e:Skin>