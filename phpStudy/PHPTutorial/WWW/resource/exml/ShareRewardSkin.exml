<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="SkinShareReward" width="560" height="677" xmlns:e="http://ns.egret.com/eui" xmlns:ns1="*" xmlns:w="http://ns.egret.com/wing">
	<e:Group left="0" right="0" top="0" bottom="0">
		<e:Image horizontalCenter="0.5" y="-8" source="shareRewardBg_png"/>
		<e:Image horizontalCenter="0" source="huabian3" top="-6"/>
		<e:Group height="18" x="102.5" y="144">
			<e:Label text="已分享：" size="18" fontFamily="Microsoft YaHei"/>
			<e:Label id="shareNum" text="0次" size="18" fontFamily="Microsoft YaHei" anchorOffsetX="0" textColor="0x1ff804" textAlign="center"/>
			<e:Label id="shareTime" text="（冷却时间：00：00：00）" size="18" fontFamily="Microsoft YaHei" anchorOffsetX="0" textAlign="center" textColor="0xffffff"/>
			<e:layout>
				<e:HorizontalLayout gap="0"/>
			</e:layout>
		</e:Group>
		<e:Image id="title0" horizontalCenter="3.5" top="15" source="shareReardBiaoti_png"/>
		<e:Scroller width="551" height="460.5" x="3.8" y="194" anchorOffsetY="0" anchorOffsetX="0">
			<e:List id="list" itemRendererSkinName="SkinShareRewardItem" anchorOffsetY="0" height="444.5">
				<e:layout>
					<e:VerticalLayout/>
				</e:layout>
			</e:List>
		</e:Scroller>
		<e:Button id="gotoShareBtn" label="Đi chia sẻ" x="423.5" y="132" icon="chat_btnbg">
			<e:skinName>
				<e:Skin states="up,down,disabled">
				<e:Image width="100%" height="100%" source="chat_btnbg" width.down="95%" height.down="95%" horizontalCenter="0" verticalCenter="0"/>
				<e:Label id="labelDisplay" horizontalCenter="0" verticalCenter="0" textColor="0x7e2a00" size="24" fontFamily="Microsoft YaHei" scaleX.down="0.95" scaleY.down="0.95"/>
				</e:Skin>
			</e:skinName>
		</e:Button>
		<e:Image id="redPoint" width="20" height="20" x="526" y="128" source="zjmhongdian"/>
	</e:Group>
</e:Skin>