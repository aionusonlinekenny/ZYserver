					<e:HorizontalLayout gap="3" verticalAlign="middle"/>
				</e:layout>
			</e:Group>
			<e:CheckBox id="autoBuy" label="自动购买" x="440" y="239" skinName="SkinCheckBox0"/>
		</e:Group>
		<e:Group id="maxShowGroup" width="600" height="103" horizontalCenter="0" verticalCenter="114" visible="false">
			<e:Group width="600" height="103" horizontalCenter="0" verticalCenter="0">
				<e:Image id="nextAttBG1" scale9Grid="16,13,559,12" source="longhuntextbg2" width="600" height="103" verticalCenter="0" horizontalCenter="0"/>
				<e:Label id="maxCurAtt" text="攻击：8000" size="18" height="103" width="300" textAlign="left"
