		<e:Label id="vipLabel" text="VIP14加成" x="82" y="613" size="16" textColor="0x00ff00"  visible="false"/>
		<e:Group id="maxGroup" horizontalCenter="0" width="600" anchorOffsetY="0" height="301" verticalCenter="185">
			<e:Group width="600" height="103" y="6" horizontalCenter="0">
				<e:Image id="nextAttBG"  
				         source="longhuntextbg2" width="600" bottom="-78" horizontalCenter="0" height="103" anchorOffsetY="0" horizontalCenter.open="0" top="10" scale9Grid="45,13,488,12"/>
				<e:Label id="nextAtt" text="攻击：8000" size="20"  height="90" 
				         width="213" textAlign="left" verticalAlign="middle" verticalCenter="0.5" horizontalCenter="191.5"  anchorOffsetX="0" textColor="0x00ff06" fontFamily="Microsoft YaHei"/>
