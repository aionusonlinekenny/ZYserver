				         verticalCenter="0.5"  x="0" verticalAlign="middle" textColor="0xffffff" fontFamily="Microsoft YaHei" anchorOffsetX="0"/>
			</e:Group>
			<e:Group width="513" height="40" id="starGroup" scaleX="0.8" scaleY="0.8"  horizontalCenter="0" verticalCenter="-30"/>
