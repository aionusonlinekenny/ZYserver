<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="SkinGuild" width="600" height="948" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing"
        xmlns:euiextension="euiextension.*" xmlns:ns1="*">
	<e:Rect fillAlpha="0.6" top="0" bottom="0" strokeColor="0x444444" fillColor="0x000000" left="0" right="0"/>
	<e:Rect fillAlpha="1" top="0" bottom="0" width="600" horizontalCenter="0" fillColor="0x5888cd"/>


	<e:Group horizontalCenter="0" width="600" height="948" verticalCenter="0">

		<e:Image  horizontalCenter="0" verticalCenter="0" source="guilddating_bg_jpg"/>

		<e:Button id="practiseBtn" right="-9" height="496" verticalCenter="-222">
			<e:Skin states="up,down,disabled" width="197.67">
				<e:Image scaleX="1" scaleY="1" includeIn="up,down,disabled"
				         alpha.up="0" visible.disabled="false" x.down="19"  source="guild_title2a_png" right.down="0.6699999999999875" verticalCenter.down="90" x="25" y="180"/>
				<e:Image visible.disabled="false" y.down="108" x.down="37"  x="37" y="108" source="guildrukou_bg_png"/>
				<e:Image visible.disabled="false" y.down="119" x.down="67"  x="67" y="119" source="guildgongnengicon_png"/>
	<e:Label text="Đại&#10;sảnh&#10;sự&#10;kiện" size="22" textAlign="center" lineSpacing="2" fontFamily="Microsoft YaHei" anchorOffsetX="0" width="90" visible.disabled="false" x="22" y="147"/>
			</e:Skin>
		</e:Button>
		<e:Button id="cityBtn" height="311" verticalCenter="-141.5" horizontalCenter="-95">
			<e:Skin states="up,down,disabled">
			<e:Image scaleX="1" scaleY="1" includeIn="up,down,disabled" alpha.up="0" visible.disabled="false" x.down="169" y.down="150.83" source="guild_title3a_png" x="169" y="151"/>
			<e:Image visible.disabled="false" y.down="70" x.down="157" x="157" y="70" source="guildrukou_bg_png"/>
			<e:Image visible.disabled="false" y.down="77" x.down="186" x="186" y="77" source="guildwaricon_png"/>
			<e:Label text="Tranh&#10;Bá&#10;Tiên&#10;Cung" size="22" textAlign="center" lineSpacing="2" fontFamily="Microsoft YaHei" anchorOffsetX="0" width="90" visible.disabled="false" x="141" y="109"/>
			</e:Skin>
		</e:Button>


		<e:Button id="manageBtn" horizontalCenter="-0.5" height="248" bottom="185">
			<e:Skin states="up,down,disabled">
				<e:Image scaleX="1" scaleY="1" includeIn="up,down,disabled"
				         alpha.up="0" visible.disabled="false" x.down="23" y.down="26.65"  scaleX.down="1" scaleY.down="1" source="guild_title4a_png" x="23" y="29"/>
				<e:Image visible.disabled="false" y.down="5" x.down="-48"  x="-48" y="5" source="guildrukou_bg_png"/>

				<e:Image visible.disabled="false" y.down="20" x.down="-20"  x="-20" y="20" source="guilddatingicon_png"/>
	<e:Label text="Đại&#10;Điện&#10;Tiên&#10;Minh" size="22" textAlign="center" lineSpacing="2" fontFamily="Microsoft YaHei" anchorOffsetX="0" width="90" visible.disabled="false" x="-65" y="43"/>
			</e:Skin>
		</e:Button>
		<e:Button id="shopBtn" horizontalCenter="92.5" height="308" bottom="106">
			<e:Skin states="up,down,disabled">
			<e:Image scaleX="1" scaleY="1" includeIn="up,down,disabled" alpha.up="0" visible.disabled="false" x.down="7.5" y.down="166" source="guild_title6a_png" horizontalCenter.disabled="-86" horizontalCenter.up="-86" x="7.5" y="166"/>
			<e:Image x="183.33" y="140.67" visible.disabled="false" y.down="140.67" x.down="183.33" source="guildrukou_bg_png"/>
			<e:Image x="211.97" y="155.05" visible.disabled="false" y.down="155.05" x.down="211.97" source="guildbossicon_png"/>
			<e:Label text="Tiên&#10;Minh&#10;Trấn&#10;Yêu" x="167" y="177.65" size="22" textAlign="center" lineSpacing="2" fontFamily="Microsoft YaHei" anchorOffsetX="0" width="90" visible.disabled="false" x.up="167" y.up="177.65"/>
			<e:Label text="BOSS" x="315.31" y="125" size="22" fontFamily="Microsoft YaHei" anchorOffsetX="0" width="59.34" scaleX="1" scaleY="1" rotation="89.92" visible.disabled="false" visible="false"/>
			</e:Skin>
		</e:Button>

		<e:Image id="redPoint1" source="zjmhongdian"  right="71" verticalCenter="-353.5"/>
		<e:Image id="redPoint2" source="zjmhongdian"  left="241" verticalCenter="-218.5"/>
		<e:Group id="message" x="5" y="770" touchEnabled="false">
			<e:Image id="chatBtn" touchEnabled="true" pixelHitTest="true" source="zjmliaotian" />
		</e:Group>
		<e:Image id="redPoint0" source="zjmhongdian"  horizontalCenter="-148.5" bottom="410"/>
		<e:Image id="redPoint3" source="zjmhongdian"  horizontalCenter="189.5" bottom="256"/>










