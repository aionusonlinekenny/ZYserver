	</e:Group>
	<e:Image scaleX="1" scaleY="1" anchorOffsetX="0" width="264" bottom="9" anchorOffsetY="0" height="100" horizontalCenter="-168" source="tongyongbg15"/>
	<e:Scroller width="246" height="66.67" anchorOffsetY="0" horizontalCenter="-174" bottom="14">
		<e:List id="list" itemRendererSkinName="SkinGongxianitem" bottom="-621" x="15.5">
			<e:layout>
				<e:VerticalLayout gap="-3"/>
			</e:layout>
		</e:List>
	</e:Scroller>
	<e:Label text="Xếp hạng cống hiến hôm nay" size="20" textColor="0xffffff" fontFamily="Microsoft YaHei" horizontalCenter="-182" bottom="88"/>
	<e:Image source="zjmfanhuikuang" horizontalCenter="254" bottom="8"/>
	<e:Button id="closeBtn" label="Nút bấm" skinName="SkinBtn0" icon="zjmfanhui" scaleX="1" scaleY="1" horizontalCenter="253.5" bottom="12"/>

