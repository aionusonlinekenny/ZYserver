        height="114" width="96">
	<e:Image id="bg"  source="qiandaobg" left="0" right="0" top="0" bottom="0"/>
	<!--<ns1:BaseComponent id="item" x="6.5" y="10" skinName="SkinItem"/>
	-->
	<ns1:ItemBase id="item" skinName="SkinItem3"  horizontalCenter="0" top="10"/>
	<e:Group id="vipFlagGroup" x="0" y="0">
		<e:Image id="vipFlag"  source="qiandaobq" rotation="0" left="0" top="0"/>
		<e:Label id="vipLab" text="V2 gấp đôi" x="0" y="33" size="16" rotation="-45"
		         textAlign="center"  fontFamily="Microsoft YaHei" textColor="0xffdf00"/>
	</e:Group>
	<e:Rect id="checkedMask" fillAlpha="0.7" fillColor="0x222222" width="94" height="112" y="1" x="1" visible="false"/>
	<e:Image id="checked" source="duoxuangou" verticalCenter="0" horizontalCenter="0" height="42" width="42" visible="false"/>
	<e:Image id="complement" source="qiandaobu" right="0" bottom="0" visible="false"/>
	<e:Group id="dayFlagGroup" x="0" y="0" visible="false">
		<e:Image id="dayFlag" x="0" y="0"    source=""/>
		<e:Label id="dayLab" text="998 ngày" x="0.5" y="29" size="14" fontFamily="黑体" rotation="-45" stroke="1" 
		         width="40.66" verticalAlign="middle" textAlign="center" textColor="0xffe79d" />
	</e:Group>
</e:Skin>