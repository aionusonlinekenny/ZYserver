					<e:HorizontalLayout gap="0"/>
				</e:layout>
				</e:List>
				<e:Scroller id="item" left="4" top="50" bottom="0" right="4" scrollPolicyH="off" scrollPolicyV="on" anchorOffsetY="0">
				<e:List id="list" itemRendererSkinName="SDProjectItemSkin" left="0" top="0" right="0" bottom="0">
					<e:layout>
						<e:VerticalLayout gap="5"/>
					</e:layout>
				</e:List>
