<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="sevenDayWin" width="600" height="948" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing" xmlns:ns1="*"  >
	<e:Rect fillAlpha="0.6" left="0" right="0" top="0" bottom="0"/>
	<e:Group top="0" bottom="0" width="600" horizontalCenter="0">
		<e:Image scale9Grid="10,9,27,30" width="600" source="vipbg_png" horizontalCenter="0" top="0" bottom="0"/>
		<ns1:RoleSelectPanel id="roleSelect" currentState="nohead" width="600" horizontalCenter="0" top="0" skinName="SkinRoleSelectPanel"/>
		<e:Image horizontalCenter="-0.5" scale9Grid="25,25,15,19" anchorOffsetY="0" source="vipbg4_png" width="563" top="106" bottom="105"/>
		<e:Image horizontalCenter="-125" source="shang_2_png" touchEnabled="false"/>
		<e:Group id="infoBg" y="108" horizontalCenter="-0.5">
			<e:Image source="sevendaytopbg_png" x="0" y="0"/>
			<e:Group y="70.7" anchorOffsetY="0" height="67" anchorOffsetX="0" width="358" horizontalCenter="100.5">
			<e:Label text="Thời gian còn lại:" size="18" left="0" top="0" textColor="0xffffff" fontFamily="Microsoft YaHei"/>
			<e:Label id="actTime0" text="6 ngày 23 giờ 10 phút" size="18" textColor="0x00ff00" fontFamily="Microsoft YaHei" top="0" left="90"/>
			<e:Label id="actInfo0" text="                 Hoàn thành nhiệm vụ sự kiện trong 7 ngày kể từ khi mở sự kiện để tích điểm và giành giải thưởng lớn " size="18"  anchorOffsetX="0" textColor="0xffffff" fontFamily="Microsoft YaHei" left="0" right="1" verticalCenter="10.5" anchorOffsetY="0" height="46"/>
			<e:Label text="Mô tả sự kiện:" size="18" left="0" top="21" textColor="0xffffff" fontFamily="Microsoft YaHei"/>
			</e:Group>
			<e:Image x="117" y="8" source="biaoti_qitianle_png"/>
		</e:Group>
