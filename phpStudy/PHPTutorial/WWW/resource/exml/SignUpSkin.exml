<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="SkinSignup" width="600" height="728" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing">
	<e:Group id="knockoutGroup" left="0" right="0" top="0" bottom="0" visible="false">
		<e:Image source="tongyongmianbanbg" scale9Grid="23,22,2,1" left="0" right="0" top="0" bottom="0"/>
		<e:Group id="dinghong" height="70" bottom="5" width="570" horizontalCenter="0">
			<e:Image top="0" bottom="0" source="bantoumingkuang3" left="0" width="300"/>
			<e:Image scaleX="-1" top="0" bottom="0" source="bantoumingkuang3" right="0" width="300"/>
		</e:Group>
		<e:Group id="state1" bottom="48" horizontalCenter="0">
		<e:Label id="eliminateInfoLabel" text="Vòng loại trực tiếp hiện tại vòng 1, còn lại 88 người, chiến tích của tôi：8 thắng 1 thua" x="0" y="0" size="16" textColor="0x00FF00"/>
		<e:layout>
			<e:HorizontalLayout gap="0"/>
		</e:layout>
		</e:Group>
		<e:Group id="state2" horizontalCenter="0" bottom="22">
		<e:Label id="info" text="Vòng loại trực tiếp thua 5 trận sẽ bị loại, mỗi trận cách nhau 5 phút" x="0" y="0" size="16" textColor="0xff9900" bold="true"/>
		<e:Label text="；Đếm ngược trận tiếp theo" x="108" y="1" size="16" textColor="0x00FF00"/>
		<e:Label id="nextStartCountdownLabel" text=" 04 phút 39 giây" x="118" y="11" size="16" textColor="0x00FF00"/>
		<e:layout>
			<e:HorizontalLayout gap="0"/>
		</e:layout>
		</e:Group>
		<e:Scroller id="eliminateListScroller" horizontalCenter="0" top="40" bottom="80" scrollPolicyH="off" x="2" y="45" width="560" height="610">
		<e:List id="eliminateInfoList" x="18" y="1" itemRendererSkinName="SkinKnockoutListItem">
			<e:layout>
			<e:VerticalLayout gap="0"/>
			</e:layout>
		</e:List>
		</e:Scroller>
		<e:Group y="0" left="5" right="5">
			<e:Image y="0" source="pailietoubg2" scale9Grid="21,0,2,40" left="0" right="0"/>
			<e:Image y="5" source="pailietouline2" height="30" x="210"/>
			<e:Image y="5" source="pailietouline2" height="30" x="370"/>
			<e:Label y="9" text="Trận đấu" size="20" x="87" textColor="0x9f946d"/>
			<e:Label y="9" text="Đối thủ" size="20" x="267" textColor="0x9f946d"/>
			<e:Label y="9" text="Thắng bại" size="20" x="447" textColor="0x9f946d"/>
		</e:Group>
	</e:Group>
	<e:Group id="signGroup" left="0" right="0" top="0" bottom="0">
		<e:Image source="peakness_bg_png" top="0" horizontalCenter="0" scale9Grid="275,347,17,17" height="651"/>
		<e:Image width="579" height="260" horizontalCenter="0.5" x="41" top="86" scale9Grid="9,5,10,9" source="tongyongbg11"/>
		<e:Image width="579" height="140" horizontalCenter="0" scale9Grid="9,5,10,9" x="41" verticalCenter="155" source="tongyongbg11"/>
		<e:Label id="signUpRuleTxt" text="" size="20" anchorOffsetY="0" left="25" right="25" top="111" lineSpacing="7" textColor="0xf0f4fe" fontFamily="Microsoft YaHei" anchorOffsetX="0"/>
		<e:List id="rewardList" left="49" right="31" height="106" verticalCenter="158" itemRendererSkinName="SkinItem2">
		<e:layout>
			<e:HorizontalLayout horizontalAlign="center" verticalAlign="middle" gap="30" paddingLeft="4"/>
		</e:layout>
		</e:List>
		<e:Label id="signed" text="Đã đăng ký" bottom="25" horizontalCenter="0" textColor="0x00FF00" fontFamily="Microsoft YaHei" visible="false"/>
		<e:Group id="btnGroup" bottom="25" horizontalCenter="-1.5">
