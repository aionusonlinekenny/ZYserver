<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="TreasureChuanshiGift" xmlns:e="http://ns.egret.com/eui"
        xmlns:w="http://ns.egret.com/wing" xmlns:euiextension="euiextension.*" xmlns:ns1="*" height="930" width="580" states="normal,special" >
	<e:Rect id="bgClose" left="0" right="0" top="0" bottom="0" fillAlpha="0.6"/>
	<e:Group id="anigroup"  horizontalCenter="0" verticalCenter="-12" width="484" height="430" anchorOffsetY="0">
		<e:Image source="tongyong_dikuang2" scale9Grid="24,14,73,59" width="484" top="9" bottom="9" horizontalCenter="0"/>
		<e:Image anchorOffsetX="0" source="tongyong_dikuang1" anchorOffsetY="0" width="434" scale9Grid="22,20,25,25" horizontalCenter="0" top="37" bottom="89"/>
		<e:Image source="tongyong_juanzhou" width="481" horizontalCenter="0" top="0"/>
		<e:Image left="109" right="108" source="tongyong_titlebg" anchorOffsetX="0" width="249" top="-15"/>
		<e:Label text="Chọn Gói Quà" size="22" horizontalCenter="0" x="144" top="0" fontFamily="Microsoft YaHei" textColor="0x084151"/>
		<e:Label id="already" text="Đã nhận" size="22" horizontalCenter="0" x="213" fontFamily="Microsoft YaHei" textColor="0x00ff06" bottom="37"/>
		<e:Label id="choose" y="47" text="Vui lòng chọn 1 trong các vật phẩm sau" size="20" horizontalCenter="0" fontFamily="Microsoft YaHei" textColor="0x001828"/>
		<e:List id="gift" horizontalCenter="0" itemRendererSkinName="TreasureChuanshiItem" height="200" verticalCenter="-39.5">
			<e:layout>
				<e:TileLayout requestedRowCount="4" requestedColumnCount="4"/>
			</e:layout>
			<e:layout.special>
				<e:HorizontalLayout/>
			</e:layout.special>
		</e:List>
		<e:Button id="get" label="Nhận" horizontalCenter="0" bottom="22" skinName="SkinBtn3"/>
		<e:Group id="add" width="380" height="60" horizontalCenter="0" bottom="92" x="-190" y="0">
			<e:Button id="sub1Btn0" label="" skinName="SkinBtn0" icon="btn-" verticalCenter="0" horizontalCenter="-80"/>
			<e:Button id="add1Btn0" label="" skinName="SkinBtn0" icon="btnadd" verticalCenter="0" horizontalCenter="80" x="10" y="10"/>
			<e:Button id="maxBtn0" label="Tối đa" icon="btnmax2" skinName="SkinBtn0" verticalCenter="0" right="43"/>
			<e:Button id="minBtn0" label="Tối thiểu" icon="btnmax2" x="80" skinName="SkinBtn0" rotation="180" verticalCenter="0"/>
			<e:Image width="100" height="38" source="shuzibg" verticalCenter="0" horizontalCenter="0" scale9Grid="8,4,10,14"/>
			<e:EditableText id="numLabel0" text="1" textAlign="center" size="30" width="90" verticalCenter="0" horizontalCenter="0" fontFamily="Microsoft YaHei" textColor="0xffffff"/>
		</e:Group>
		<e:Group id="tipGroup" touchChildren="false" touchEnabled="false" bottom="-39" y="601" horizontalCenter="0">
			<e:Image source="bantoutiaobg" height="40" y="0" horizontalCenter="0" scale9Grid="128,2,15,41" width="300"/>
			<e:Label text="Chạm vùng trống để đóng cửa sổ" size="20" horizontalCenter="0" textColor="0xFFFFFF" fontFamily="Microsoft YaHei" verticalCenter="-3"/>
			<e:Button id="closeBtn0" label="Nút bấm" y="-17" skinName="SkinBtn0" right="-10" x="188" visible="false"/>
		</e:Group>
	</e:Group>
</e:Skin>