			<e:Label text="仙盟排名" y="6" size="18" x="166" width="81" height="32" fontFamily="Microsoft YaHei" textColor="0xffffff"/>
			<e:Label text="仙盟积分" y="6" size="18" x="-7" textColor="0xffffff" fontFamily="Microsoft YaHei"/>
			<e:Label id="guildPoint" text="123456" y="6" size="18" x="73" textColor="0xffffff" fontFamily="Microsoft YaHei"/>
			<e:Label id="guildRank" text="123456" y="6" size="18" x="246" textColor="0xffffff" fontFamily="Microsoft YaHei"/>
