			<e:Label text="个人排名" y="5" size="18" x="166" fontFamily="Microsoft YaHei" textColor="0xffffff"/>
			<e:Label id="myRank" text="123456" y="5" size="18" x="246" textColor="0xffffff" fontFamily="Microsoft YaHei"/>
