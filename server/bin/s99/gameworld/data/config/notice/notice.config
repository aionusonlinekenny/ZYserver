	content = "|C:0xff0000&T:【Mùa Giải Đỉnh Phong - Liên Server Top 4】|tin thắng trận mới của Mùa Giải Đỉnh Phong, |C:0x16b2ff&T:%s[s%d]|dùng chiến thuật sắc bén đánh bại |C:0x16b2ff&T:%s[s%d]|thăng hạng |C:0x00ff00&T:Top 4|!",
},
[345] = {
	id = 345,
	type = 1,
	content = "|C:0xff0000&T:【Mùa Giải Đỉnh Phong - Liên Server Bán Kết】|khói lửa nổi lên khắp nơi! Giữa lúc sấm chớp vang trời, |C:0x16b2ff&T:%s[s%d]|đánh bại |C:0x16b2ff&T:%s[s%d]|thăng hạng |C:0x00ff00&T:Chung Kết Tổng|!",
},
[346] = {
	id = 346,
	type = 1,
	content = "|C:0xff0000&T:【Mùa Giải Đỉnh Phong - Liên Server Chung Kết Tổng】|trải qua vô số trận đấu kinh thiên động địa, trong trận chung kết tổng |C:0x16b2ff&T:%s[s%d]|đã đánh bại |C:0x16b2ff&T:%s[s%d]|, |C:0x00ff00&T:Chí Tôn Đệ Nhất Cường Giả|ra đời!",
},
[347] = {
