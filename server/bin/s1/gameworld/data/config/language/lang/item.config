	n200111 = "万圣糖果",
	d200111 = "使用随机获得以下物品中的一个：|C:0x18ff00&T:\n元宝*50\n御器精魄*10\n护盾碎片*10\n主宰碎片*10\n洗髓丹*10|\n祝大家万圣节快乐！",
