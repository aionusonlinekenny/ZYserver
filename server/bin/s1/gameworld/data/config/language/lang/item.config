	n260075 = "Câu Hồn Đoạt Mệnh",
	n260076 = "Phúc Hải Thiên Đào",
	n260077 = "Lạc Anh Trảm Long",
	n260078 = "Tứ Phương Khai Tận",
	n260079 = "Trấn Áp Vạn Thế",
	n260080 = "Nghịch Chuyển Âm Dương",
