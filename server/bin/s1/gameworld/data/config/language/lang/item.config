	n260082 = "Thiên Địa Chung Yên",
	n260083 = "Giang Sơn Quyển",
	n260084 = "Kim Long Lệnh",
	n260085 = "Tiên Ma Đồ",
	n260086 = "Trấn Thiên Ấn",
	n260087 = "Linh Lung Tháp",
	n260088 = "Tam Sinh Kính",
	n260089 = "Bất Hủ Đăng",
	n260090 = "Càn Khôn Lô",
	n260091 = "Tiên Tư Ngọc Sắc",
	n260092 = "Phong Hoa Tuyệt Đại",
	n260093 = "Niểu Na Sính Đình",
	n260094 = "Lệ Chất Thiên Thành",
	n260095 = "Quốc Sắc Thiên Hương",
	n260096 = "Kim Kỳ Lân",
	n270001 = "Thẻ Kinh Nghiệm Sơ Cấp",
	n270002 = "Thẻ Kinh Nghiệm Trung Cấp",
	n270003 = "Thẻ Kinh Nghiệm Cao Cấp",
	d260001 = "一种大多生活在荒野中的猫，钉耙猫偷窃农民的钩子用来做武器",
	d260002 = "稻草人受到邪恶的、未知的力量驱使下逐渐变异",
	d260003 = "一种大多生活在荒野中的猫，钉耙猫偷窃农民的钉耙用来做武器",
	d260004 = "独角甲虫受到邪恶力量变异成拥有巨大的角并作为武器",
	d260005 = "红野猪变异而来，比他们的祖先更加迅速和灵活。不仅保持了巨大的可怕力量，更快的动作会给任何对手造成麻烦。",
	d260006 = "它们挥舞巨大的棒子攻击入侵者。一旦发现敌人，它们会跑起来并残忍地抡起大棒进攻。它们近乎荒谬的力量可能会使你受到伤害。",
	d260007 = "它们居住在洞穴深处，尽管没有很强的力量，但快速的行动和攻击却能使你防不胜防。",
	d260008 = "经过红蛇出没的毒蛇谷。它没有毒液，但是因为成群结队而比较难以对付。它锋利的牙齿能很容易地将盔甲咬出一个窟窿。",
	d260009 = "它身上长着黄色的斑纹，它锋利的牙齿足以在你的盔甲上咬出洞来。",
	d260010 = "强有力的昆虫类生物。它们有坚硬的外壳保护身体，进攻敌人时会以六条腿快速移动。一定要当心被它坚硬的表皮伤害。由于长期生活在黑暗的洞穴中，它们已经丧失了视力，但它们敏锐的触角可以通过气味或湿度来感知敌人的威胁。",
	d260011 = "这是一种令人不快的，穿着盔甲的蛇。它那悬着的巨大的眼睛可以望向任何方向。除了钳子，它长长的、锋利的牙齿也会造成致命的威胁。",
	d260012 = "这种巨大的钳虫在相当长的时期里已经起了变异，不能与普通的钳虫相比。它们几乎能够毫无怜悯地杀掉任何敌人。它们坚硬的外壳由于不断地锻造而十分强大，使大多数敌人的攻击都不起作用。",
	d260013 = "出现在死亡谷的深处。它们已经有呼风唤雨的能力，所以常被看成是神",
	d260014 = "它们是红色恶猪的领头者，不知道它们已活了多久。由于更长的寿命，他们比红色恶猪更大的体形和更强的破坏力。",
	d260015 = "经过白花蛇出没的毒蛇谷。它没有毒液，但是因为成群结队而比较难以对付。它锋利的牙齿能很容易地将盔甲咬出一个窟窿。",
	d260016 = "沃玛护卫在神殿中保卫沃玛教主，并因为重生的缘故而竭尽全力。他们是邪恶秘境的生物，有着强大的魔法力量。",
	d260017 = "沃玛神殿的保卫者，在这里他们很强大",
	d260018 = "一种不起眼的蜘蛛，但不要小看它，死亡时会跟你同归于尽",
	d260019 = "作为蜘蛛中捕猎好手，最强大的武器是无比强大的剧毒",
	d260020 = "们使用弓箭以准确地攻击远距离的入侵者。它们力量并不强大，但动作迅速，能远距离攻击。",
	d260021 = "如果看到巨型蜘蛛这样的怪物向你冲过来，多数情况下你都会惊骇得夺路而逃。",
	d260022 = "它们是祖玛教的保卫者，也具有隐藏在雕像中的羊血化身。",
	d260023 = "它的身上长满权杖一样的巨刺，身体也被赤月恶魔的腐化力量染成暗红色。但是最恐怖的还是它那对巨钳，任何敌人都会被它轻易撕裂。",
	d260024 = "这种蜘蛛的幼虫寄生在老树的根部或者一些动物的体内，从寄主身上获取营养。一旦找到合适的新居所，幼虫就会很快孵化为成熟的幻影蜘蛛。",
	d260025 = "沃玛神殿的保卫者，在这里他们很强大",
	d260026 = "这种蜘蛛看起来就像一朵美丽的花。赤月恶魔把这种巨大的怪物变成了一种用外表诱惑猎物，再用毒液毒死它们的魔鬼。",
	d260027 = "它的身体里充满着红色的滚烫液体，让它时时刻刻都十分痛苦。可是如果遇到了它，痛苦恐怕要转移到你身上来了。",
	d260028 = "羊被祖玛教作为祭品而成了神的象征。这种石头雕像在祖玛神殿里随处可见，当入侵者靠得足够近时，他们那以羊血构成的化身会从雕像中出来发动攻击。",
	d260029 = "沃玛勇士同样保卫着神殿，他们曾是沃玛教的成员，沃玛教主复活后他们被杀死，死后的尸体变成沃玛勇士。",
	d260030 = "没有武器但能喷射出强有力的火焰。作为沃玛中最高的等级，它们还长有仙羽。",
	d260031 = "它是个强大的魔鬼，被沃玛教众奉为神明而被追随，如果有机会重聚力量，它能摧毁人类秘境。",
	d260032 = "赤月恶魔长期潜伏在山谷深处，代表着秘境上最邪恶、最强大的势力。它们是一切罪恶的根源。它们最为可怕的能力来自非凡的黑暗智慧。",
	d260033 = "祖玛教众把恶魔的石像供奉为它们的神。它是一尊站立在祖玛神殿深处的神像，当入侵者靠近时它就会苏醒。一旦醒来，它会发出巨大的火焰攻击它的敌人。",
	d260034 = "来自深渊的大魔王，汲取敌人的恐惧化为自身的力量，为世间带来黑暗是他永恒的使命。",
	d260035 = "魔叉牛护法作为忠诚的护法一直未黑暗力量提供诡计",
	d260036 = "牛魔教主对自己的身世来历讳莫如深",
	d260037 = "黑龙作为天空中最强大的黑暗力量，可不要轻易惹怒它，最好远离它。",
	d260038 = "拥有凶恶的外面，却总是在思考秘境上还有多少人类",
	d260039 = "作为守护黑暗力量的傀儡，当你靠近时，变化身傀儡师毁灭一切保护黑暗力量。",
	d260040 = "火龙王的护卫，终身守护火龙洞穴",
	d260041 = "火龙王的亲卫，对一切威胁火龙王的东西统统毁灭",
	d260042 = "作为火龙族中首领，誓死带领着火龙一族走向繁荣",
	d260043 = "作为火龙一族的奴隶，终身为火龙一族服务，也从中获得强大力量",
	d260044 = "作为传说中的神龙，通常见头不见尾" ,
	d260045 = "作为牛魔一族的勇士，手持双斧。",
	d260046 = "传说中的神兽，生活在深海中，能见到恐怕是不可能的。",
	d260047 = "拥有正派的名字，却是黑暗的大帝，传说拥有无边的发力",
	d260048 = "拥有一颗曾经被伤害的苦苦的等待他的归来。",
	d260049 = "作为龙王的女儿美丽并且聪明",
	d260050 = "拥有让人过目不忘的脸庞，大大的眼睛痴痴的看着你",
	d260051 = "能与鸟类进行共鸣的美丽女子",
	d260052 = "想见她，除非睡着。",
	d260053 = "一位永远守护着蟠桃园的姑娘",
	d260054 = "一个永远不知疲倦为了爱而采蜜的女子。",
	d260055 = "当你沉入大海时梦见的女子。",
	d260056 = "为了世间的光明永世提着灯笼",
	d260057 = "一位感动了天地的女子。",
	d260058 = "火辣辣的性格注定了不平凡的人生",
	d260059 = "为剑而生，为剑而死的奇女子",
	d260060 = "走在深林中脸庞中能感受她的亲吻",
	d260061 = "一首勾住人心的曲声，却不知何处。",
	d260062 = "散发着各种迷人花香的异国女子",
	d260063 = "身着贵气，手舞长枪的贵妇人",
	d260064 = "年少无知，对爱痴痴的美女",
	d260065 = "你的命中情人",
	d260066 = "传说中的神兽，主杀伐，守护着北方的天空",
	d260067 = "用于激活圣战金装、法神金装、天尊金装组内的任意一张图鉴\n激活可获得对应职业属性：\n\n|C:0x00ff00&T:攻击： +2160\n防御： +540\n法抗： +540\n生命： +29400|\n\n战力从此暴涨|C:0x00ff00&T:15600|！",
	d260068 = "天魔金甲--装逼专用卡组，只能花钱得（此条5毛，括号内删除）",
	d260069 = "圣战金盔--装逼专用卡组，只能花钱得（此条5毛，括号内删除）",
