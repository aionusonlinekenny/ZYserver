	d202005 = "学习后可强化灵宠的技能效果\n每提升一级，通过能力提升的基础属性将额外增加|C:0x00ff00&T:5%|\n\n|C:0xff00ff&T:在灵宠技能界面使用|",
	d202006 = "学习后可以提高灵宠的攻击能力\n每提升一级，灵宠的|C:0xf8b141&T:灵力震荡|，|C:0xf8b141&T:灵力爆破|，|C:0xf8b141&T:灵力轰炸|伤害提高|C:0x00ff00&T:50000|点\n\n|C:0xff00ff&T:在灵宠技能界面使用|",
	d202007 = "学习后可以提高灵宠的攻击能力\n每提升一级，灵宠的|C:0xf8b141&T:灵力震荡|，|C:0xf8b141&T:灵力爆破|，|C:0xf8b141&T:灵力轰炸|攻击间隔缩短|C:0x00ff00&T:0.6|秒\n\n|C:0xff00ff&T:在灵宠技能界面使用|",
	d202008 = "学习后可以提高灵宠的攻击能力\n每提升一级，灵宠的|C:0xf8b141&T:灵力震荡|，|C:0xf8b141&T:灵力爆破|，|C:0xf8b141&T:灵力轰炸|伤害系数每级提高|C:0x00ff00&T:5%|\n\n|C:0xff00ff&T:在灵宠技能界面使用|",
	d202009 = "使用后可将灵宠晋升为|C:0xffd93f&T:仙灵|\n，永久增加其|C:0x00FF00&T:5%|的成长属性",
