	d260082 = "法神金带--装逼专用卡组，只能花钱得（此条5毛，括号内删除）",
	d260083 = "用于激活天尊金装组内的任意一张图鉴\n获得以下属性：\n\n长歌攻击： +2160\n长歌防御： +540\n长歌法抗： +540\n长歌生命： +29400\n\n战力从此暴涨15600！",
	d260084 = "天师金袍--装逼专用卡组，只能花钱得（此条5毛，括号内删除）",
	d260085 = "天尊金冠--装逼专用卡组，只能花钱得（此条5毛，括号内删除）",
	d260086 = "天尊金链--装逼专用卡组，只能花钱得（此条5毛，括号内删除）",
	d260087 = "天尊金镯--装逼专用卡组，只能花钱得（此条5毛，括号内删除）",
	d260088 = "天尊金戒--装逼专用卡组，只能花钱得（此条5毛，括号内删除）",
	d260089 = "天尊金靴--装逼专用卡组，只能花钱得（此条5毛，括号内删除）",
	d260090 = "天尊金带--装逼专用卡组，只能花钱得（此条5毛，括号内删除）",
	d260091 = "过尽千帆皆不是，斜晖脉脉水悠悠。",
	d260092 = "掌中舞罢箫声绝，三十六宫秋夜长",
	d260093 = "共在人间说天上，不知天上忆人间",
	d260094 = "终南山后，活死人墓，神雕侠侣，绝迹江湖",
	d260095 = "衣带如练，裙裾如裳",
	d260096 = "传说中的神兽，祥瑞与力量的象征，守卫着大地",
	d270001 = "用于提升图鉴的星级，拥有5点经验值",
	d270002 = "用于提升图鉴的星级，拥有50点经验值",
	d270003 = "用于提升图鉴的星级，拥有500点经验值",
