},
[5] = {
	id = 5,
	title = "|C:0xf8b141&T:Gửi người bạn thân mến|",
	content = "Chúc mừng bạn đã hoàn thành hành trình nhập môn Tiên Đồ, nhưng con đường tu tiên của bạn chỉ vừa khởi hành, kẻ địch mạnh hơn phía trước cần sự giúp đỡ của bạn bè, hãy nhanh chóng mạnh lên và cùng bạn bè viết nên huyền thoại Tiên Đồ.\nBạn có thể mạnh lên qua các cách sau:\n1.Lên cấp 70 gia nhập |C:0x35e62b&T:Tiên Minh| cùng nhau phát triển\n2.Thông qua |C:0x35e62b&T:Vượt Ải|, |C:0x35e62b&T:Phó Bản Kinh Nghiệm| để lên cấp nhanh\n3.|C:0x35e62b&T:Vượt Ải| và |C:0x35e62b&T:thử thách BOSS| để nhận trang bị",
	attachment = {{type=1,id=200100,count=1}},
},
[6] = {
	id = 6,
	title = "Thưởng Thông Quan",
	content = "Đây là thưởng thông quan, chú ý nhận",
},
[7] = {
	id = 7,
	title = "|C:0xf8b141&T:Chúc mừng bạn đạt cấp 55!|",
	content = "Chúc mừng bạn đã đạt cấp 55, dưới đây là mẹo giúp bạn nhanh chóng tăng chiến lực:\n  1.Thử thách |C:0x00ff00&T:Ải| để tăng |C:0x00ff00&T:【Kinh Nghiệm】|, tăng hiệu suất vượt ải\n  2.Vào |C:0x00ff00&T:Phó Bản Kinh Nghiệm| và |C:0x00ff00&T:Phó Bản Hạo Thiên Tháp| để nhanh chóng nhận lượng lớn |C:0x00ff00&T:【Kinh Nghiệm】|, tăng cấp vọt\n  3.|C:0xFF0000&T:Nạp lần đầu| để nhận trang bị Cam cao cấp, kích hoạt thần khí, |C:0xFF0000&T:【Chiến Lực】| tăng vọt, dễ dàng áp đảo mọi BOSS\n  4.|C:0xFF0000&T:vip2| mở khóa sớm nhân vật thứ hai, |C:0xFF0000&T:vip4| mở khóa sớm nhân vật thứ ba, |Chiến Lực| nhân đôi, giúp bạn vượt ải lên cấp\n  5.Nạp VIP để tăng tốc chiến lực |U:&C:0x00ff00&E:RechargeFirstWin,ChargeFirstWin&T:đi nạp ngay|",
},
[8] = {
	id = 8,
	title = "|C:0xf8b141&T:Chúc mừng bạn đạt cấp 80!|",
	content = "Chúc mừng bạn đã đạt cấp 80, đã tiến bậc thành cao thủ!\n  1.Mở |C:0xFF0000&T:hệ thống Chuyển Sinh| mới, chuyển sinh nhận |C:0x00ff00&T:lượng lớn thuộc tính|, mặc trang bị |C:0x00ff00&T:Chuyển Sinh| cực phẩm, tiêu diệt |C:0x00ff00&T:BOSS| cấp cao hơn\n  2.Mở chế độ PVP mới |C:0xff0000&T:Vương Giả Tranh Bá|, tham gia nhận thưởng |C:0x00ff00&T:đẳng cấp| cực phẩm, trở thành bá chủ được vạn người ngưỡng mộ\n  3.Mở chế độ tranh đoạt BOSS mới |C:0xff0000&T:Thiên Địa Yêu Trủng|, nhận trang bị cao cấp và |C:0x00ff00&T:Hỏa Phù| quý giá, |C:0x00ff00&T:【Chiến Lực】| tăng vọt, dễ dàng áp đảo mọi BOSS\n  4.Mở |C:0xFF0000&T:quét nhiều lần| Phó Bản Kinh Nghiệm, trải nghiệm cảm giác cấp độ |C:0x00ff00&T:tăng vọt|\n  5.Rảnh thì xem thêm |U:&C:0x00ff00&E:ActivityWin&T:hoạt động mở server| nhé",
},
