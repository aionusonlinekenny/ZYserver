[4] = {
	id = 4,
	title = "|C:0xf8b141&T:Thương Khung Kiếm Quyết tặng bạn phúc lợi|",
	content = "Đây là lộ phí tặng bạn (10 triệu Nguyên Bảo + 20 triệu Kim Tệ + 999 Trực Thăng Đan + 999 Chuyển Sinh Đan), chúc bạn sớm chiếm lĩnh Hoàng Thành~! Cảm ơn bạn đã ủng hộ Thương Khung Kiếm Quyết!",
